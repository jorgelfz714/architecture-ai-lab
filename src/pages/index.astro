          </div>
          <div class="ice-principles">
            <div>
              <span class="t-eyebrow">01 &middot; Empirical Rigor</span>
              <p class="t-s" style="margin-top: 6px;">We measure real failure modes alongside breakthroughs—never cherry-picked renders.</p>
            </div>
            <div>
              <span class="t-eyebrow">02 &middot; Open Architecture</span>
              <p class="t-s" style="margin-top: 6px;">Static, transparent, zero-bloat publishing designed to endure as a living archive.</p>
            </div>
            <div>
              <span class="t-eyebrow">03 &middot; Connected Knowledge</span>
              <p class="t-s" style="margin-top: 6px;">Every publication links automatically into the lab's spatial knowledge graph.</p>
            </div>
          </div>
          <div class="card-ticks-bot"><span class="tick"></span><span class="tick"></span></div>
        </div>
      </section>

      <!-- =====================================================
           INDEX TABLE CARD (Genesis "Newest openings" style)
           ===================================================== -->
