  <!-- =========================================================
       SCRIPTS: 1) STUDIO 3D ARCHITECTURAL SCULPTURE ENGINE
                2) STICKY CONNECT SCROLL TRACKER + STEP BUTTONS
                3) LIVE TIMECODE + MOBILE HAMBURGER MENU
       ========================================================= -->
  <script is:inline>
    // 1. Mobile Hamburger Menu
    (function () {
      var btn = document.getElementById('genesis-nav-toggle');
      var links = document.getElementById('genesis-nav-links');
      if (!btn || !links) return;
      function setOpen(open) {
        links.classList.toggle('open', open);
        btn.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      }
      btn.addEventListener('click', function () { setOpen(!links.classList.contains('open')); });
      links.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
      window.addEventListener('resize', function () { if (window.innerWidth > 768) setOpen(false); });
    })();

    // 2. Live Studio Timecode (00:01:28+)
    (function () {
      var el = document.getElementById('hero-timecode');
      if (!el) return;
      var secs = 88;
      setInterval(function () {
        secs = (secs + 1) % 3600;
        var m = String(Math.floor(secs / 60)).padStart(2, '0');
        var s = String(secs % 60).padStart(2, '0');
        el.textContent = '00:' + m + ':' + s;
      }, 1000);
    })();

    // 3. Sticky Connect Scroll Sync + Step Controls
    (function () {
      var sections = [
        document.getElementById('overview'),
        document.getElementById('tools'),
        document.getElementById('workflows'),
        document.getElementById('experiments')
      ].filter(Boolean);

      var counter = document.getElementById('sticky-counter');
      var headline = document.getElementById('sticky-headline');
      var chapterLinks = Array.prototype.slice.call(document.querySelectorAll('.sticky-chapter-link'));
      var btnPrev = document.getElementById('btn-step-prev');
      var btnNext = document.getElementById('btn-step-next');
      var activeIdx = 0;

      function applyActive(idx) {
        activeIdx = Math.max(0, Math.min(sections.length - 1, idx));
        if (counter) counter.textContent = '0' + activeIdx + '/3';
        var sec = sections[activeIdx];
        if (headline && sec && sec.dataset.headline) {
          headline.textContent = sec.dataset.headline;
        }
        chapterLinks.forEach(function (lk) {
          var c = parseInt(lk.getAttribute('data-chapter'), 10);
          lk.classList.toggle('active', c === activeIdx);
        });
      }

      if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var idx = parseInt(entry.target.getAttribute('data-section-index'), 10);
              if (!isNaN(idx)) applyActive(idx);
            }
          });
        }, { rootMargin: '-35% 0px -45% 0px', threshold: 0.05 });

        sections.forEach(function (s) { obs.observe(s); });
      }

      if (btnPrev) {
        btnPrev.addEventListener('click', function () {
          var target = sections[Math.max(0, activeIdx - 1)];
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
      if (btnNext) {
        btnNext.addEventListener('click', function () {
          var target = sections[Math.min(sections.length - 1, activeIdx + 1)];
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    })();

  </script>
