                      <img src={featuredTool.data.coverImage || '/graphics/cover-urban-classification.jpg'} alt={featuredTool.data.title} loading="lazy" />
                      <span class="media-overlay-cta">Open Tool Dossier &rarr;</span>
                    </div>
                    <div class="media-meta">
                      <span class="t-eyebrow-muted">Tool &middot; Prototype</span>
                      <span class="t-eyebrow">{featuredTool.data.title}</span>
                    </div>
                  </a>
                )}
                {manifestoNote && (
                  <a href={`/notes/${manifestoNote.id}`} class="media-item">
                    <div class="media-thumb-box">
                      <img src={manifestoNote.data.coverImage || '/graphics/cover-manifiesto-laboratorio.jpg'} alt={manifestoNote.data.title} loading="lazy" />
                      <span class="media-overlay-cta">Read Manifesto &rarr;</span>
                    </div>
                    <div class="media-meta">
                      <span class="t-eyebrow-muted">Lab Core &middot; Manifesto</span>
