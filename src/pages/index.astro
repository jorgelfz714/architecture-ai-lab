---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const allExperiments = await getCollection('experiments');
const allWork = await getCollection('work');
const allNotes = await getCollection('notes');
const allResources = await getCollection('resources');

// Sort experiments by date descending
const sortedExperiments = allExperiments.sort((a, b) => b.data.date.localeCompare(a.data.date));
const exp005 = sortedExperiments.find(e => e.id.includes('conceptual-framework-and-workflow')) || sortedExperiments[0];
const exp004 = sortedExperiments.find(e => e.id.includes('where-ai-actually-works-in-aec')) || sortedExperiments[1];
const otherExperiments = sortedExperiments.filter(e => e.id !== exp005?.id && e.id !== exp004?.id);

const recentWork = allWork.sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
const recentResources = allResources.sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
const recentNotes = allNotes.sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
---

<BaseLayout 
  title="Architecture AI Lab — Technical Craft & Spatial Computation"
  description="Independent digital laboratory directed by Jorge Ludeña. Empirical AI benchmarking, reproducible architectural frameworks, and automated spatial workflows."
  fullWidth={true}
>
  <div class="andmade-home">
    
    <!-- ========================================================
         HERO SECTION: ANDMADE EDITORIAL DISCIPLINE
         ======================================================== -->
    <section class="hero-grid" aria-labelledby="hero-title">
      <div class="hero-main">
        <div class="hero-kicker">
          <span>CYCLE 2026.2 // COMPUTATIONAL MORPHOLOGY &bull; AEC BENCHMARKS</span>
        </div>
        
        <h1 id="hero-title" class="hero-title">
          Architecture is changing.
          <span class="hero-title-light">Make something new.</span>
        </h1>

        <p class="hero-statement">
          An independent digital laboratory directed by <strong>Jorge Ludeña</strong>. We conduct empirical investigations, build reproducible spatial workflows, and map the genuine computational inflection points where machine intelligence elevates architectural craft.
        </p>

        <div class="hero-actions">
          <a href="#experiments-grid" class="btn-technical">
            Explore Lab Experiments &darr;
          </a>
          <a href="/about" class="btn-ghost-tech">
            Operating Protocol &rarr;
          </a>
        </div>
      </div>

      <!-- HERO SIDE SPECIFICATION COLUMN -->
      <aside class="hero-side">
        <div class="side-cell">
          <div class="side-label">01 / Principal Investigator</div>
          <div class="side-value">Jorge Ludeña</div>
          <div class="side-sub">Direction, curation &amp; final critical judgment.</div>
        </div>

        <div class="side-cell">
          <div class="side-label">02 / Primary Focus</div>
          <div class="side-value">Spatial Computation</div>
          <div class="side-sub">Parametric solvers, LLMs, IFC geometry &amp; deterministic checks.</div>
        </div>

        <div class="side-cell">
          <div class="side-label">03 / Operational Thesis</div>
          <div class="side-value">Replicable Systems</div>
          <div class="side-sub">Moving beyond isolated prompts to structured node graphs.</div>
        </div>

        <div class="side-cell">
          <div class="side-label">04 / Target Stack</div>
          <div class="side-value">$0.00 / Month</div>
          <div class="side-sub">Astro Static &bull; Netlify Edge &bull; Open Science repositories.</div>
        </div>
      </aside>
    </section>

    <!-- OPERATING PRINCIPLE BANNER -->
    <section class="director-rule-bar" aria-label="Principio rector">
      <div class="drb-badge">Golden Rule</div>
      <div class="drb-content">
        <strong>Jorge Ludeña selects, directs and approves.</strong> The AI operational partner researches, develops, structures, designs, implements and prepares publication.
      </div>
      <div class="drb-meta">AUTONOMOUS RUNNER // END-TO-END VERIFIED</div>
    </section>

    <!-- ========================================================
         SECTION 01: CORE STUDIES & BENCHMARKS (EXP_005 & EXP_004)
         ======================================================== -->
    <section id="experiments-grid" aria-labelledby="sec-exp-title">
      <div class="sec-header">
        <div class="sec-header-left">
          <span class="sec-num">01</span>
          <h2 id="sec-exp-title" class="sec-title">Empirical Experiments &amp; Frameworks</h2>
          <span class="sec-desc">(Verified lab records and benchmarks)</span>
        </div>
        <a href="/experiments" class="sec-link">View All Records ({sortedExperiments.length}) &rarr;</a>
      </div>

      <div class="studies-grid">
        <!-- STUDY 01: EXP_005 -->
        {exp005 && (
          <article class="study-cell">
            <div>
              <div class="study-header">
                <span class="study-id-pill">
                  <strong>{exp005.data.idCode || 'EXP_005'}</strong> // METHODOLOGY
                </span>
                <span class="study-status-tag">Published &bull; {exp005.data.date}</span>
              </div>

              <h3 class="study-title">
                <a href={`/experiments/${exp005.id}`}>
                  {exp005.data.title}
                </a>
              </h3>

              <p class="study-desc">
                {exp005.data.description}
              </p>
            </div>

            <div class="study-tools-tray">
              {exp005.data.tools && (
                <div class="tools-list">
                  {exp005.data.tools.map((tool: string) => (
                    <span class="tool-chip">{tool}</span>
                  ))}
                </div>
              )}
              
              <div class="study-footer">
                <span>DOI: {exp005.data.doi || '10.1038/arch.ai.2026.051'}</span>
                <a href={`/experiments/${exp005.id}`} class="study-arrow-link">
                  Open Technical Dossier &rarr;
                </a>
              </div>
            </div>
          </article>
        )}

        <!-- STUDY 02: EXP_004 -->
        {exp004 && (
          <article class="study-cell">
            <div>
              <div class="study-header">
                <span class="study-id-pill">
                  <strong>{exp004.data.idCode || 'EXP_004'}</strong> // BENCHMARK
                </span>
                <span class="study-status-tag">Published &bull; {exp004.data.date}</span>
              </div>

              <h3 class="study-title">
                <a href={`/experiments/${exp004.id}`}>
                  {exp004.data.title}
                </a>
              </h3>

              <p class="study-desc">
                {exp004.data.description}
              </p>
            </div>

            <div class="study-tools-tray">
              {exp004.data.tools && (
                <div class="tools-list">
                  {exp004.data.tools.map((tool: string) => (
                    <span class="tool-chip">{tool}</span>
                  ))}
                </div>
              )}
              
              <div class="study-footer">
                <span>DOI: {exp004.data.doi || '10.1038/arch.ai.2026.042'}</span>
                <a href={`/experiments/${exp004.id}`} class="study-arrow-link">
                  Open Technical Dossier &rarr;
                </a>
              </div>
            </div>
          </article>
        )}
      </div>

      <!-- MORE EXPERIMENTS IF ANY -->
      {otherExperiments.length > 0 && (
        <div class="sub-records-grid">
          {otherExperiments.map((item) => (
            <Card
              title={item.data.title}
              description={item.data.description}
              date={item.data.date}
              href={`/experiments/${item.id}`}
              category="experiment"
              tags={item.data.tags}
              idCode={item.data.idCode}
              readingTime={item.data.readingTime}
            />
          ))}
        </div>
      )}
    </section>

    <!-- ========================================================
         SECTION 02: TRI-COLUMN MODULES (SYSTEMS, WORKFLOWS, NOTES)
         ======================================================== -->
    <section aria-labelledby="sec-tri-title">
      <div class="sec-header">
        <div class="sec-header-left">
          <span class="sec-num">02</span>
          <h2 id="sec-tri-title" class="sec-title">Systems, Protocols &amp; Field Notes</h2>
          <span class="sec-desc">(Computational prototypes, prompts and critical inquiry)</span>
        </div>
        <a href="/work" class="sec-link">Explore Systems Archive &rarr;</a>
      </div>

      <div class="tri-grid">
        <!-- SYSTEM RECORD -->
        {recentWork.length > 0 && (
          <article class="tri-cell">
            <div>
              <div class="tri-meta">
                <span>SYSTEMS &bull; WORK</span>
                <span>{recentWork[0].data.date}</span>
              </div>
              <h3 class="tri-title">
                <a href={`/work/${recentWork[0].id}`}>
                  {recentWork[0].data.title}
                </a>
              </h3>
              <p class="tri-desc">
                {recentWork[0].data.description}
              </p>
            </div>
            <div class="tri-foot">
              <span>{recentWork[0].data.tags?.[0] || 'Computational'}</span>
              <a href={`/work/${recentWork[0].id}`}>&rarr;</a>
            </div>
          </article>
        )}

        <!-- WORKFLOW RECORD -->
        {recentResources.length > 0 && (
          <article class="tri-cell">
            <div>
              <div class="tri-meta">
                <span>PROTOCOLS &bull; RESOURCES</span>
                <span>{recentResources[0].data.date}</span>
              </div>
              <h3 class="tri-title">
                <a href={`/resources/${recentResources[0].id}`}>
                  {recentResources[0].data.title}
                </a>
              </h3>
              <p class="tri-desc">
                {recentResources[0].data.description}
              </p>
            </div>
            <div class="tri-foot">
              <span>{recentResources[0].data.tags?.[0] || 'Workflow'}</span>
              <a href={`/resources/${recentResources[0].id}`}>&rarr;</a>
            </div>
          </article>
        )}

        <!-- FIELD NOTE RECORD -->
        {recentNotes.length > 0 && (
          <article class="tri-cell">
            <div>
              <div class="tri-meta">
                <span>EPISTEMOLOGY &bull; NOTES</span>
                <span>{recentNotes[0].data.date}</span>
              </div>
              <h3 class="tri-title">
                <a href={`/notes/${recentNotes[0].id}`}>
                  {recentNotes[0].data.title}
                </a>
              </h3>
              <p class="tri-desc">
                {recentNotes[0].data.description}
              </p>
            </div>
            <div class="tri-foot">
              <span>{recentNotes[0].data.tags?.[0] || 'Theory'}</span>
              <a href={`/notes/${recentNotes[0].id}`}>&rarr;</a>
            </div>
          </article>
        )}
      </div>
    </section>

    <!-- ========================================================
         SECTION 03: MANIFESTO STATEMENT
         ======================================================== -->
    <section class="manifesto-callout">
      <div class="manifesto-inner">
        <span class="mono-meta-callout">
          // ARCHITECTURAL DIRECTION //
        </span>
        <h2 class="manifesto-title">
          Traditional design friction is dead.<br />
          Systemic orchestration is the new architectural craft.
        </h2>
        <p class="manifesto-lead">
          We replace romanticized manual trial-and-error with deterministic computational pipelines. The architect's value is no longer measured by manual drafting hours, but by the precision of design intent and the critical rigor of curation.
        </p>
        <div class="manifesto-actions">
          <a href="/experiments/conceptual-framework-and-workflow-for-architects-with-ai" class="btn-technical">
            Read Framework 01, 02 &amp; 03 &rarr;
          </a>
          <span class="mono-meta">ESTIMATED READING: 11 MIN &bull; COMPLETE BLUEPRINT</span>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .andmade-home {
    max-width: var(--max-width);
    margin: 0 auto;
    border-left: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    background: var(--bg-primary);
  }

  /* HERO GRID */
  .hero-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-main {
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 3.5vw, 3rem);
    border-right: 1px solid var(--border-subtle);
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin-bottom: 1.75rem;
  }

  .hero-title-light {
    font-weight: 400;
    color: var(--text-muted);
    display: block;
  }

  .hero-statement {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 660px;
    margin-bottom: 2.25rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .hero-statement strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-technical {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.85rem 1.6rem;
    background: var(--text-primary);
    color: var(--bg-secondary);
    border: 1px solid var(--text-primary);
    border-radius: var(--radius-xs);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .btn-technical:hover {
    background: transparent;
    color: var(--text-primary);
  }

  .btn-ghost-tech {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.85rem 1.6rem;
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xs);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .btn-ghost-tech:hover {
    border-color: var(--text-primary);
    background: rgba(0, 0, 0, 0.03);
  }

  /* HERO SIDE COLUMN */
  .hero-side {
    display: flex;
    flex-direction: column;
    background: var(--bg-tertiary);
  }

  .side-cell {
    padding: 1.6rem 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .side-cell:last-child {
    border-bottom: none;
  }

  .side-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .side-value {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .side-sub {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.2rem;
    line-height: 1.4;
  }

  /* DIRECTOR BANNER */
  .director-rule-bar {
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.15rem clamp(1.5rem, 3.5vw, 3rem);
    background: var(--bg-secondary);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
  }

  .drb-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--text-primary);
    color: var(--bg-secondary);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  .drb-content {
    font-size: 0.92rem;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  .drb-content strong {
    color: var(--text-primary);
  }

  .drb-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* SECTION HEADERS */
  .sec-header {
    padding: 1.25rem clamp(1.5rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-primary);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .sec-header-left {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .sec-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-primary);
  }

  .sec-title {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .sec-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .sec-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .sec-link:hover {
    opacity: 0.6;
  }

  /* STUDIES GRID (EXP_005 & EXP_004) */
  .studies-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--border-subtle);
    gap: 1px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .study-cell {
    background: var(--bg-secondary);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.15s ease;
    min-height: 420px;
  }

  .study-cell:hover {
    background: #FAF9F6;
  }

  .study-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.85rem;
    gap: 0.75rem;
  }

  .study-id-pill {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-primary);
  }

  .study-status-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xs);
    color: var(--text-secondary);
  }

  .study-title {
    font-family: var(--font-sans);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .study-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .study-title a:hover {
    color: var(--accent-blue);
  }

  .study-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
  }

  .study-tools-tray {
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
  }

  .tools-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .tool-chip {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .study-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .study-arrow-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
  }

  .study-arrow-link:hover {
    text-decoration: underline;
  }

  .sub-records-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1px;
    background: var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* TRI-GRID (SYSTEMS, WORKFLOWS, NOTES) */
  .tri-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    background: var(--border-subtle);
    gap: 1px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .tri-cell {
    background: var(--bg-secondary);
    padding: 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.15s ease;
    min-height: 280px;
  }

  .tri-cell:hover {
    background: #FAF9F6;
  }

  .tri-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    display: flex;
    justify-content: space-between;
  }

  .tri-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .tri-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .tri-title a:hover {
    color: var(--accent-blue);
  }

  .tri-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .tri-foot {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.85rem;
  }

  .tri-foot a {
    font-size: 0.9rem;
    text-decoration: none;
  }

