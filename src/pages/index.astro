---
import { getCollection } from 'astro:content';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';

const experiments = await getCollection('experiments');
const work = await getCollection('work');
const notes = await getCollection('notes');
const resources = await getCollection('resources');

const featuredExp = experiments.find(e => e.id.includes('where-ai-actually-works-in-aec')) || experiments[0];
const frameworkExp = experiments.find(e => e.id.includes('conceptual-framework')) || experiments[1];
const featuredTool = work[0];
const featuredWorkflow = resources[0];
const manifestoNote = notes[0];

const allPublications = [
  ...experiments.map(p => ({
    title: p.data.title,
    category: 'Experiments',
    status: p.data.status || 'Published',
    url: `/experiments/${p.id}`,
    cover: p.data.coverImage || '/graphics/cover-aec-benchmark.jpg',
    desc: p.data.description,
  })),
  ...work.map(p => ({
    title: p.data.title,
    category: 'Tools',
    status: p.data.status || 'Prototype',
    url: `/work/${p.id}`,
    cover: p.data.coverImage || '/graphics/cover-urban-classification.jpg',
    desc: p.data.description,
  })),
  ...resources.map(p => ({
    title: p.data.title,
    category: 'Workflows',
    status: p.data.status || 'Available',
    url: `/resources/${p.id}`,
    cover: p.data.coverImage || '/graphics/cover-normativa-protocol.jpg',
    desc: p.data.description,
  })),
  ...notes.map(p => ({
    title: p.data.title,
    category: 'Manifesto',
    status: 'Lab Core',
    url: `/notes/${p.id}`,
    cover: p.data.coverImage || '/graphics/cover-manifiesto-laboratorio.jpg',
    desc: p.data.description,
  })),
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Architecture Lab — Architecture is changing. Make something new.</title>
  <meta name="description" content="Digital laboratory exploring tools, workflows, and empirical experiments at the intersection of architecture and AI." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg-page: #FFFFFF;
      --bg-card: #F6F6F4;
      --bg-ice: #DEE8EB;
      --ink-navy: #1A1D34;
      --ink-black: #000000;
      --ink-muted: #8A8A8A;
      --ink-soft: #5C5F6E;
      --btn-dark: #282828;
      --btn-gray: #EBEBEB;
      --btn-blue: #CAD4D9;
      --line-border: #CACACA;
      --radius-card: 16px;
      --radius-btn: 6px;
      --radius-pill: 4px;
      --site-px: 34px;
      --card-pad: 22px;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
      --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      background: var(--bg-page);
      color: var(--ink-navy);
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      background: var(--bg-page);
      color: var(--ink-navy);
      min-height: 100vh;
      overflow-x: clip;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* Typography scale (Genesis exact proportions) */
    .t-xl {
      font-family: var(--font-sans);
      font-size: clamp(2rem, 2.35vw, 2.5rem);
      font-weight: 400;
      letter-spacing: -0.05em;
      line-height: 1.04;
      color: var(--ink-navy);
    }

    .t-l {
      font-family: var(--font-sans);
      font-size: 1.125rem;
      font-weight: 400;
      letter-spacing: -0.045em;
      line-height: 1.16;
      color: var(--ink-navy);
    }

    .t-s {
      font-family: var(--font-sans);
      font-size: 0.875rem;
      font-weight: 400;
      letter-spacing: -0.025em;
      line-height: 1.38;
      color: var(--ink-soft);
    }

    .t-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.656rem; /* 10.5px */
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1.2;
      color: var(--ink-black);
    }

    .t-eyebrow-muted {
      font-family: var(--font-mono);
      font-size: 0.656rem;
      font-weight: 500;
      line-height: 1.2;
      color: var(--ink-muted);
    }

    /* Genesis signature buttons */
    .g-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      height: 28px;
      padding: 0 11px;
      border-radius: var(--radius-btn);
      border: 0;
      font-family: var(--font-mono);
      font-size: 0.656rem;
      font-weight: 500;
      line-height: 1;
      cursor: pointer;
      white-space: nowrap;
      transition: padding-right 0.32s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
    }

    .g-btn::after {
      content: '→';
      position: absolute;
      right: 10px;
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 0.25s ease 0.08s, transform 0.25s ease 0.08s;
    }

    .g-btn:hover {
      padding-right: 28px;
    }

    .g-btn:hover::after {
      opacity: 1;
      transform: translateX(0);
    }

    .g-btn-dark {
      background: var(--btn-dark);
      color: #FFFFFF;
    }
    .g-btn-dark:hover {
      background: #141414;
    }

    .g-btn-gray {
      background: var(--btn-gray);
      color: var(--ink-navy);
    }
    .g-btn-gray:hover {
      background: #DFDFDC;
    }

    .g-btn-blue {
      background: var(--btn-blue);
      color: var(--ink-navy);
    }

    /* Animated underline link */
    .hover-ul {
      position: relative;
      color: var(--ink-muted);
      transition: color 0.3s ease;
    }
    .hover-ul::before {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 50%;
      width: 0;
      height: 1px;
      background: var(--ink-navy);
      transition: left 0.3s ease, width 0.3s ease;
    }
    .hover-ul:hover {
      color: var(--ink-navy);
    }
    .hover-ul:hover::before {
      left: 0;
      width: 100%;
    }

    /* Registration ticks (-) */
    .tick {
      display: inline-block;
      width: 10px;
      height: 1px;
      background: currentColor;
      opacity: 0.72;
      pointer-events: none;
    }

    .card-ticks-top,
    .card-ticks-bot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      pointer-events: none;
    }

    /* Site wrapper */
    .site-shell {
      max-width: 2400px;
      margin: 0 auto;
    }

    /* Announcement bar */
    .announce-wrap {
      padding: 8px var(--site-px) 0;
    }
    .announce-bar {
      height: 32px;
      background: var(--ink-navy);
      color: #FFFFFF;
      border-radius: var(--radius-pill);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0 14px;
      font-family: var(--font-mono);
      font-size: 0.656rem;
      font-weight: 500;
      transition: opacity 0.2s ease;
    }
    .announce-bar:hover {
      opacity: 0.94;
    }
    .announce-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--bg-ice);
    }

    /* Header */
    .g-header {
      position: sticky;
      top: 0;
      z-index: 90;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 12px var(--site-px);
    }

    .g-header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 36px;
      position: relative;
    }

    .g-brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: -0.03em;
      color: var(--ink-navy);
    }

    .g-logo-ring {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 2px solid var(--ink-navy);
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .g-logo-ring::after {
      content: '';
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 1.2px solid var(--ink-navy);
      opacity: 0.45;
      animation: ringPulse 5s ease-in-out infinite;
    }
    @keyframes ringPulse {
      0%, 100% { transform: scale(0.82); opacity: 0.35; }
      50% { transform: scale(1.18); opacity: 0.85; }
    }

    .g-nav {
      display: flex;
      align-items: center;
      gap: 56px;
      font-size: 0.875rem;
      letter-spacing: -0.026em;
    }

    .g-nav-right {
      display: flex;
      align-items: center;
      gap: 24px;
      font-size: 0.875rem;
      letter-spacing: -0.026em;
    }

    /* Mobile hamburger */
    .nav-toggle {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 0;
      background: var(--bg-card);
      border: 1px solid #E2E2DE;
      border-radius: 8px;
      cursor: pointer;
    }
    .nav-toggle span {
      display: block;
      width: 18px;
      height: 1.5px;
      background: var(--ink-navy);
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .nav-toggle.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .nav-toggle.open span:nth-child(2) { opacity: 0; }
    .nav-toggle.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
    .g-nav-mobile-only { display: none; }

    /* =======================================================
       HERO CARD (Full-bleed matte studio 3D sculpture)
       ======================================================= */
    .hero-section {
      padding: 6px var(--site-px) 16px;
    }

    .hero-card {
      position: relative;
      background: #0E1117;
      color: #F8FAFC;
      border-radius: var(--radius-card);
      height: clamp(640px, calc(100vh - 118px), 840px);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: var(--card-pad);
      scroll-margin-top: 76px;
    }

    .hero-card .tick {
      color: rgba(255, 255, 255, 0.35);
    }

    .hero-card .t-eyebrow {
      color: rgba(248, 250, 252, 0.86);
    }

    .hero-card .t-eyebrow-muted {
      color: rgba(203, 213, 225, 0.6);
    }

    .hero-graph-stage {
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .hero-graph-stage :global(.kg-container) {
      height: 100% !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
    }

    /* 3x3 subtle registration ticks inside hero */
    .hero-ticks-layer {
      position: absolute;
      inset: var(--card-pad);
      pointer-events: none;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 1fr 1fr;
    }
    .hero-tick-cell {
      position: relative;
    }
    .ht-tl { position: absolute; top: 0; left: 0; }
    .ht-tr { position: absolute; top: 0; right: 0; }
    .ht-bl { position: absolute; bottom: 0; left: 0; }
    .ht-br { position: absolute; bottom: 0; right: 0; }

    .hero-top-row {
      position: relative;
      z-index: 3;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 8px;
      pointer-events: none;
    }

    .hero-copy-block {
      position: relative;
      z-index: 3;
      max-width: 340px;
      margin-top: auto;
      margin-bottom: auto;
      padding: 20px 22px;
      border-radius: 12px;
      background: rgba(14, 17, 23, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      pointer-events: none;
    }

    .hero-copy-block .tick {
      margin-bottom: 14px;
      color: rgba(255, 255, 255, 0.5);
    }

    .hero-copy-block h1 {
      margin-bottom: 14px;
      color: #FFFFFF;
    }

    .hero-copy-block p {
      margin-bottom: 20px;
      color: rgba(226, 232, 240, 0.8);
      max-width: 295px;
    }

    .hero-copy-block .g-btn-dark {
      background: #FFFFFF;
      color: #0E1117;
    }
    .hero-copy-block .g-btn-dark:hover {
      background: #E2E8F0;
    }

    .hero-copy-block .g-btn-gray {
      background: rgba(255, 255, 255, 0.12);
      color: #FFFFFF;
    }
    .hero-copy-block .g-btn-gray:hover {
      background: rgba(255, 255, 255, 0.22);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      pointer-events: auto;
    }

    .hero-bottom-row {
      position: relative;
      z-index: 3;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 4px;
      pointer-events: none;
    }

    /* =======================================================
       SPLIT STICKY CONNECT SECTION (33% sticky / 67% content)
       ======================================================= */
    .connect-section {
      padding: 0 var(--site-px) 16px;
    }

    .connect-block {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    .connect-sticky {
      width: 33%;
      flex-shrink: 0;
      position: sticky;
      top: 72px;
      height: calc(100vh - 88px);
      max-height: 760px;
      min-height: 520px;
      background: var(--bg-card);
      border-radius: var(--radius-card);
      padding: var(--card-pad);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .sticky-top-text {
      padding-top: 12px;
      max-width: 260px;
    }

    .sticky-mid {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      border-top: 1px solid transparent;
      padding: 14px 0;
      position: relative;
    }

    .sticky-mid-ticks {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      justify-content: space-between;
    }

    .sticky-chapters {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .sticky-chapter-link {
      font-size: clamp(1.65rem, 2.1vw, 2.15rem);
      font-weight: 400;
      letter-spacing: -0.05em;
      line-height: 1.08;
      color: var(--ink-muted);
      transition: color 0.25s ease;
    }
    .sticky-chapter-link:hover,
    .sticky-chapter-link.active {
      color: var(--ink-navy);
    }

    .sticky-counter-box {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding-top: 6px;
    }
    .counter-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 22px;
      padding: 0 7px;
      background: #EBEBE8;
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 0.656rem;
      font-weight: 500;
      color: var(--ink-navy);
    }
    .counter-btn {
      width: 22px;
      height: 22px;
      border: 0;
      border-radius: 4px;
      background: #EBEBE8;
      color: var(--ink-navy);
      font-size: 0.6rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }
    .counter-btn:hover {
      background: #DCDCD8;
    }

    .sticky-footer-meta {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 12px;
      padding-bottom: 10px;
    }
    .sticky-meta-col {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .sticky-meta-col.right {
      text-align: right;
    }

    /* Right scrolling column */
    .connect-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .g-card {
      background: var(--bg-card);
      border-radius: var(--radius-card);
      padding: var(--card-pad);
      display: flex;
      flex-direction: column;
      gap: 20px;
      scroll-margin-top: 76px;
    }

    /* 4-Pillar Accordion Strip (Signature Genesis 01-04 Dark-Slate-Ice-White frame) */
    .pillar-frame {
      background: var(--ink-navy);
      border-radius: 12px;
      padding: 12px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      min-height: 360px;
    }

    .pillar-col {
      border-radius: 8px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      transition: transform 0.25s ease, filter 0.25s ease;
      position: relative;
      overflow: hidden;
    }
    .pillar-col:hover {
      transform: translateY(-2px);
    }

    .pillar-col.p-1 { background: #2D3248; color: rgba(255,255,255,0.88); }
    .pillar-col.p-2 { background: #647182; color: rgba(255,255,255,0.92); }
    .pillar-col.p-3 { background: #C8D3D8; color: var(--ink-navy); }
    .pillar-col.p-4 { background: #FFFFFF; color: var(--ink-navy); }

    .pillar-num {
      font-family: var(--font-mono);
      font-size: 0.656rem;
      font-weight: 500;
      opacity: 0.85;
      margin-bottom: 12px;
      display: block;
    }
    .pillar-name {
      font-size: 1.05rem;
      font-weight: 400;
      letter-spacing: -0.04em;
      line-height: 1.15;
      margin-bottom: 8px;
    }
    .pillar-desc {
      font-size: 0.78rem;
      line-height: 1.35;
      opacity: 0.78;
    }
    .pillar-thumb {
      margin-top: 16px;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: 5px;
      opacity: 0.92;
      border: 1px solid rgba(0, 0, 0, 0.08);
    }

    /* Section narrative header inside right cards */
    .card-head {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 460px;
    }
    .card-eyebrow-pair {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    /* Featured media / dossier cards inside right column */
    .media-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .media-item {
      display: flex;
      flex-direction: column;
      gap: 10px;
      group: true;
    }

    .media-thumb-box {
      position: relative;
      border-radius: 10px;
      overflow: hidden;
      background: #E8E8E4;
      aspect-ratio: 16 / 10;
    }
    .media-thumb-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .media-item:hover .media-thumb-box img {
      transform: scale(1.03);
    }

    .media-overlay-cta {
      position: absolute;
      bottom: 12px;
      left: 12px;
      height: 24px;
      padding: 0 10px;
      border-radius: 6px;
      background: rgba(26, 29, 52, 0.78);
      backdrop-filter: blur(7px);
      color: #FFFFFF;
      font-family: var(--font-mono);
      font-size: 0.656rem;
      display: inline-flex;
      align-items: center;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .media-item:hover .media-overlay-cta {
      opacity: 1;
      transform: translateY(0);
    }

    .media-meta {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    /* Benchmark metrics strip inside EXP_004 card */
    .exp-metrics-strip {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--line-border);
    }
    .exp-metric-cell {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .exp-metric-val {
      font-size: 1.5rem;
      font-weight: 400;
      letter-spacing: -0.05em;
      color: var(--ink-navy);
    }

    /* =======================================================
       ABOUT / MANIFESTO ICE-BLUE CARD (#DEE8EB)
       ======================================================= */
    .full-band {
      padding: 0 var(--site-px) 16px;
    }

    .ice-card {
      background: var(--bg-ice);
      border-radius: var(--radius-card);
      padding: var(--card-pad);
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    .ice-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 24px;
      align-items: start;
    }

    .ice-principles {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      padding-top: 20px;
      border-top: 1px solid rgba(26, 29, 52, 0.14);
    }

    /* =======================================================
       PUBLICATIONS TABLE CARD (Genesis "Newest openings" list)
       ======================================================= */
    .openings-card {
      background: var(--bg-card);
      border-radius: var(--radius-card);
      padding: var(--card-pad);
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .openings-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 24px;
      align-items: start;
    }

    .openings-count {
      font-family: var(--font-mono);
      font-size: 0.656rem;
      vertical-align: super;
      margin-left: 4px;
      color: var(--ink-navy);
    }

    .pub-table {
      display: flex;
      flex-direction: column;
    }

    .pub-row {
      display: grid;
      grid-template-columns: minmax(0, 1.8fr) minmax(0, 0.9fr) minmax(0, 0.7fr) 16px;
      gap: 12px;
      align-items: center;
      padding: 14px 0;
      border-top: 1px solid var(--line-border);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-black);
      transition: padding-left 0.2s ease, background-color 0.2s ease;
    }
    .pub-row:last-child {
      border-bottom: 1px solid var(--line-border);
    }
    .pub-row:hover {
      padding-left: 6px;
    }
    .pub-row-cat {
      color: var(--ink-soft);
    }
    .pub-row-status {
      color: var(--ink-muted);
    }
    .pub-row-arrow {
      text-align: right;
      font-size: 0.7rem;
      color: var(--ink-navy);
    }

    .openings-footer-row {
      display: flex;
      justify-content: flex-end;
      padding-top: 14px;
    }

    /* =======================================================
       DEEP NAVY FOOTER CARD (#1A1D34)
       ======================================================= */
    .footer-band {
      padding: 0 var(--site-px) 24px;
    }

    .g-footer {
      background: var(--ink-navy);
      color: var(--bg-ice);
      border-radius: var(--radius-card);
      padding: var(--card-pad);
      min-height: 360px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 48px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      gap: 24px;
      align-items: start;
    }

    .footer-brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: #FFFFFF;
      font-size: 1rem;
      letter-spacing: -0.03em;
    }
    .footer-brand .g-logo-ring {
      border-color: #FFFFFF;
    }
    .footer-brand .g-logo-ring::after {
      border-color: #FFFFFF;
    }

    .footer-tagline {
      color: #FFFFFF;
      font-size: 1.125rem;
      letter-spacing: -0.04em;
      line-height: 1.2;
      margin-top: 12px;
    }

    .footer-col {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .footer-link {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--bg-ice);
      opacity: 0.85;
      transition: opacity 0.2s;
    }
    .footer-link:hover {
      opacity: 1;
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 12px;
      padding-top: 18px;
      border-top: 1px solid rgba(222, 232, 235, 0.14);
      font-family: var(--font-mono);
      font-size: 0.656rem;
      color: rgba(222, 232, 235, 0.65);
    }

    /* =======================================================
       RESPONSIVE BREAKPOINTS
       ======================================================= */
    @media (max-width: 1080px) {
      .connect-block {
        flex-direction: column;
      }
      .connect-sticky {
        position: static;
        width: 100%;
        height: auto;
        min-height: auto;
        max-height: none;
        gap: 24px;
      }
      .pillar-frame {
        grid-template-columns: repeat(2, 1fr);
      }
      .ice-grid,
      .openings-grid {
        grid-template-columns: 1fr;
      }
      .footer-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      :root {
        --site-px: 14px;
        --card-pad: 16px;
      }

      .announce-bar {
        font-size: 0.6rem;
        text-align: center;
      }

      .g-nav-right {
        display: none;
      }
      .nav-toggle {
        display: inline-flex;
      }

      .g-nav {
        display: none;
        position: absolute;
        top: calc(100% + 12px);
        left: -14px;
        right: -14px;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding: 8px 20px 16px;
        background: #FFFFFF;
        border-top: 1px solid #E8E8E4;
        border-bottom: 1px solid #E8E8E4;
        box-shadow: 0 18px 36px rgba(26, 29, 52, 0.08);
      }
      .g-nav.open {
        display: flex;
      }
      .g-nav a {
        padding: 13px 0;
        border-bottom: 1px solid #F0F0EC;
        color: var(--ink-navy);
        font-size: 0.95rem;
      }
      .g-nav-mobile-only {
        display: block;
      }

      .hero-card {
        height: auto;
        min-height: 620px;
        gap: 14px;
      }

      .hero-graph-stage {
        position: relative;
        height: 360px;
        border-radius: 12px;
        overflow: hidden;
        margin-top: 6px;
      }

      .hero-graph-stage :global(.kg-hud-telemetry) {
        top: 10px;
        left: 10px;
      }

      .hero-graph-stage :global(.kg-controls) {
        bottom: 10px;
        right: 10px;
      }

      .hero-copy-block {
        margin-top: 0;
        margin-bottom: 0;
        padding: 16px;
        background: rgba(20, 24, 33, 0.88);
        max-width: 100%;
      }

      .pillar-frame {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .media-grid-2,
      .exp-metrics-strip,
      .ice-principles,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .pub-row {
        grid-template-columns: minmax(0, 1fr) auto;
      }
      .pub-row-cat,
      .pub-row-status {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="site-shell">

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="announce-wrap">
      <a href="/experiments/where-ai-actually-works-in-aec" class="announce-bar">
        <span class="announce-dot"></span>
        <span>New Benchmark EXP_004: Where AI Actually Works in AEC &mdash; Read full dossier</span>
      </a>
    </div>

    <!-- MINIMAL HEADER -->
    <header class="g-header">
      <div class="g-header-inner">
        <a href="/" class="g-brand">
          <span class="g-logo-ring" aria-hidden="true"></span>
          <span>AI Architecture Lab</span>
        </a>

        <nav class="g-nav" id="genesis-nav-links" aria-label="Navegación principal">
          <a href="/work" class="hover-ul">Tools</a>
