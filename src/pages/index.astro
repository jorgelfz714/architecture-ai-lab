                <a href="/experiments" class="g-btn g-btn-gray">View all dossiers</a>
              </div>
            </div>
          </div>
          <div class="card-ticks-bot"><span class="tick"></span><span class="tick"></span></div>
        </div>
      </section>
    </main>

    <!-- =====================================================
         DEEP NAVY FOOTER CARD (#1A1D34)
         ===================================================== -->
    <div class="footer-band">
