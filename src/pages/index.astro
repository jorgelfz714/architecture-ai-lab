            </div>

            <div>
              <div class="sticky-footer-meta">
                <div class="sticky-meta-col">
                  <span class="t-eyebrow">Interactive Map</span>
                  <a href="#knowledge-graph" class="t-eyebrow-muted hover-ul">Explore node graph</a>
                </div>
                <div class="sticky-meta-col right">
                  <span class="t-eyebrow">Lab Inquiries</span>
                  <a href="/about" class="t-eyebrow-muted hover-ul">About Jorge Ludeña</a>
