              <div>
                <a href="/experiments" class="g-btn g-btn-dark">Explore experiments</a>
              </div>
              <div class="card-ticks-bot"><span class="tick"></span><span class="tick"></span></div>
            </article>
          </div>
        </div>
      </section>

      <!-- =====================================================
           ABOUT / MANIFESTO ICE-BLUE CARD (#DEE8EB)
           ===================================================== -->
      <section class="full-band">
        <div class="ice-card">
          <div class="card-ticks-top"><span class="tick"></span><span class="tick"></span></div>
          <div class="ice-grid">
            <div class="card-eyebrow-pair">
              <span class="t-eyebrow-muted">About</span>
              <span class="t-eyebrow">Beyond the ordinary.</span>
