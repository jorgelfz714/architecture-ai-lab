              </div>
              <div class="card-ticks-bot"><span class="tick"></span><span class="tick"></span></div>
            </div>
          </aside>

          <!-- Right Scrolling Content Cards -->
          <div class="connect-content">
            <!-- 00/3: 4-PILLAR OVERVIEW + KNOWLEDGE GRAPH -->
            <article class="g-card" id="overview" data-section-index="0" data-headline="We explore every layer where AI meets architectural design.">
              <div class="pillar-frame">
                <a href="#tools" class="pillar-col p-1">
                  <div>
                    <span class="pillar-num">01</span>
                    <div class="pillar-name">Tools</div>
                    <p class="pillar-desc">Algorithmic analyzers and spatial prototypes.</p>
                  </div>
                  <img src="/graphics/cover-urban-classification.jpg" alt="Spatial Tools" class="pillar-thumb" loading="lazy" />
                </a>
                <a href="#workflows" class="pillar-col p-2">
                  <div>
                    <span class="pillar-num">02</span>
                    <div class="pillar-name">Workflows</div>
                    <p class="pillar-desc">Structured prompts and parametric pipelines.</p>
                  </div>
                  <img src="/graphics/cover-normativa-protocol.jpg" alt="AI Workflows" class="pillar-thumb" loading="lazy" />
                </a>
                <a href="#experiments" class="pillar-col p-3">
                  <div>
                    <span class="pillar-num">03</span>
                    <div class="pillar-name">Experiments</div>
                    <p class="pillar-desc">Empirical AEC benchmarks and stress tests.</p>
                  </div>
                  <img src="/graphics/cover-aec-benchmark.jpg" alt="AEC Benchmarks" class="pillar-thumb" loading="lazy" />
