        <button type="button" class="nav-toggle" id="genesis-nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="genesis-nav-links">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main>
      <!-- =====================================================
           HERO: FULL-BLEED INTERACTIVE KNOWLEDGE GRAPH
           ===================================================== -->
      <section class="hero-section">
        <div class="hero-card" id="knowledge-graph">
          <!-- Registration Ticks Grid -->
          <div class="hero-ticks-layer" aria-hidden="true">
            <div class="hero-tick-cell"><span class="tick ht-tl"></span><span class="tick ht-tr"></span></div>
            <div class="hero-tick-cell"><span class="tick ht-tr"></span></div>
            <div class="hero-tick-cell"><span class="tick ht-tr"></span></div>
            <div class="hero-tick-cell"><span class="tick ht-tl"></span><span class="tick ht-bl"></span><span class="tick ht-br"></span></div>
            <div class="hero-tick-cell"><span class="tick ht-tr"></span><span class="tick ht-br"></span></div>
            <div class="hero-tick-cell"><span class="tick ht-tr"></span><span class="tick ht-br"></span></div>
          </div>

          <div class="hero-top-row">
            <span class="t-eyebrow">Meet the Lab &middot; Interactive Knowledge Graph</span>
            <span class="t-eyebrow" id="hero-timecode">00:01:28</span>
          </div>

          <!-- Interactive Obsidian-style Knowledge Graph -->
          <div class="hero-graph-stage">
            <KnowledgeGraph theme="obsidian" height="100%" offsetRight={true} />
          </div>

          <div class="hero-copy-block">
            <span class="tick" aria-hidden="true"></span>
            <h1 class="t-xl">Architecture is changing.<br />Make something new.</h1>
            <p class="t-s">
              What if AI could change the way you design, the tools you use, and the ideas you bring to life? Less repetition. More exploration.
            </p>
            <div class="hero-actions">
              <a href="/work" class="g-btn g-btn-dark">Explore AI Tools</a>
              <a href="#overview" class="g-btn g-btn-gray">Explore layers</a>
            </div>
          </div>

          <div class="hero-bottom-row">
            <span class="t-eyebrow-muted">Drag any node &middot; Click to open dossier</span>
            <span class="t-eyebrow-muted">ETSAM &middot; Open Research</span>
          </div>
        </div>
      </section>

      <!-- =====================================================
           SPLIT STICKY CONNECT SECTION (33% LEFT / 67% RIGHT)
           ===================================================== -->
      <section class="connect-section">
        <div class="connect-block">
          <!-- Sticky Left Navigation Card -->
          <aside class="connect-sticky" aria-label="Índice de capas del laboratorio">
            <div>
              <div class="card-ticks-top"><span class="tick"></span><span class="tick"></span></div>
              <p class="t-l sticky-top-text" id="sticky-headline">
                We explore every layer where AI meets architectural design.
              </p>
            </div>

            <div class="sticky-mid">
              <div class="sticky-mid-ticks" aria-hidden="true"><span class="tick"></span><span class="tick"></span></div>
              <nav class="sticky-chapters" aria-label="Categorías">
                <a href="#tools" class="sticky-chapter-link" data-chapter="1">Tools</a>
                <a href="#workflows" class="sticky-chapter-link" data-chapter="2">Workflows</a>
                <a href="#experiments" class="sticky-chapter-link" data-chapter="3">Experiments</a>
              </nav>
              <div class="sticky-counter-box">
                <span class="counter-pill" id="sticky-counter">00/3</span>
                <button type="button" class="counter-btn" id="btn-step-prev" aria-label="Sección anterior">▲</button>
                <button type="button" class="counter-btn" id="btn-step-next" aria-label="Sección siguiente">▼</button>
