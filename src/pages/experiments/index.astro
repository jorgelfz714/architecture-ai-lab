---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const allExperiments = await getCollection('experiments');
const sortedExperiments = allExperiments.sort((a, b) => b.data.date.localeCompare(a.data.date));
const featuredExp = sortedExperiments.find(e => e.id.includes('where-ai-actually-works-in-aec')) || sortedExperiments[0];
---

<BaseLayout 
  title="Ensayos &amp; Experimentos (Research Division)"
  description="Ensayos técnicos, preguntas empíricas y benchmarks de frontera en arquitectura, razonamiento espacial y modelos de lenguaje."
>
  <div class="exp-catalog-wrap">
    
    <!-- CATALOG HEADER -->
    <header class="catalog-header">
      <div class="cat-kicker">
        <span>RESEARCH DIVISION // BENCHMARKS</span>
        <span class="dot-sep">&bull;</span>
        <span class="verified-pill">VERIFIED LAB RECORDS</span>
      </div>
      <h1 class="cat-title">Experimentos &amp; Ensayos Empíricos</h1>
      <p class="cat-desc">
        El banco de pruebas de <strong>Architecture AI Lab</strong>: protocolos de evaluación abiertos, análisis de geometría IFC, generación de código para Grasshopper y evaluación honesta de dónde la IA falla estructuralmente.
      </p>
    </header>

    <!-- FEATURED BANNER -->
    {featuredExp && (
      <div class="featured-hero-card">
        <div class="f-badge-row">
          <span class="f-badge">EXPERIMENTO 01 // DESTACADO</span>
          <span class="f-peer">PEER REVIEWED DRAFT</span>
          <span class="f-doi">DOI: {featuredExp.data.doi || '10.1038/arch.ai.2026.042'}</span>
        </div>
        <h2 class="f-title">
          <a href={`/experiments/${featuredExp.id}`}>{featuredExp.data.title}</a>
        </h2>
        <p class="f-desc">{featuredExp.data.description}</p>
        
        <div class="f-bottom-row">
          <div class="f-chips">
            <span class="f-chip-lbl">Evaluación:</span>
            <span class="f-chip">GPT-4o</span>
            <span class="f-chip">Claude 3.5</span>
            <span class="f-chip">o1-preview</span>
            <span class="f-chip">IFC 4.3</span>
          </div>
          <a href={`/experiments/${featuredExp.id}`} class="f-cta-btn">
            Abrir Dossier Técnico &rarr;
          </a>
        </div>
      </div>
    )}

    <!-- ALL EXPERIMENTS GRID -->
    <div class="catalog-section">
      <div class="catalog-filter-bar">
        <span class="filter-lbl">Todos los Registros ({sortedExperiments.length})</span>
      </div>

      <div class="grid">
        {sortedExperiments.map((item) => (
          <Card
            title={item.data.title}
            description={item.data.description}
            date={item.data.date}
            href={`/experiments/${item.id}`}
            category="experiment"
            tags={item.data.tags}
            idCode={item.data.idCode}
            readingTime={item.data.readingTime}
            isFeatured={item.id === featuredExp?.id}
          />
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .exp-catalog-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }
  .catalog-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .cat-kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.64rem;
    font-weight: 700;
    color: #686862;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
  }
  .dot-sep { color: rgba(0, 0, 0, 0.2); }
  .verified-pill { color: #059669; font-weight: 800; }
  .cat-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    color: #0D0D0D;
    margin-bottom: 0.85rem;
    font-family: 'Inter', system-ui, sans-serif;
  }
  .cat-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #383834;
    max-width: 760px;
  }

  /* FEATURED HERO CARD IN CATALOG */
  .featured-hero-card {
    background: #FFFFFF;
    border: 1.5px solid #0D0D0D;
    border-radius: 18px;
    padding: 2.25rem 2.5rem;
    margin-bottom: 3.5rem;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.04);
  }
  .f-badge-row {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .f-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 800;
    background: #0D0D0D;
    color: #FFFFFF;
    padding: 0.18rem 0.6rem;
    border-radius: 9999px;
  }
  .f-peer {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    color: #059669;
    background: rgba(5, 150, 105, 0.09);
    padding: 0.18rem 0.6rem;
    border-radius: 9999px;
  }
  .f-doi {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    color: #686862;
  }
  .f-title {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #0D0D0D;
    line-height: 1.18;
    margin-bottom: 0.85rem;
    font-family: 'Inter', system-ui, sans-serif;
  }
  .f-title a { color: inherit; text-decoration: none; }
  .f-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #383834;
    max-width: 820px;
    margin-bottom: 1.5rem;
  }
  .f-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .f-chips {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .f-chip-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    color: #686862;
    text-transform: uppercase;
    margin-right: 0.2rem;
  }
  .f-chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: #383834;
    background: #EFEFEA;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  .f-cta-btn {
    background: #0D0D0D;
    color: #FFFFFF;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: opacity 0.15s, transform 0.15s;
  }
  .f-cta-btn:hover { opacity: 0.88; transform: translateY(-1px); }

  /* CATALOG GRID */
  .catalog-filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .filter-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #0D0D0D;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }
</style>
