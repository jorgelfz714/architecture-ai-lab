---
import { getCollection } from 'astro:content';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';

const experiments = await getCollection('experiments');
const work = await getCollection('work');
const notes = await getCollection('notes');
const resources = await getCollection('resources');

const featuredExp = experiments.find(e => e.id.includes('where-ai-actually-works-in-aec')) || experiments[0];
---

<!DOCTYPE html>
<html lang="es" class="genesis-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Architecture Lab — Genesis Futuristic Edition // 2026.4</title>
  <meta name="description" content="Super-futuristic computational interface for AI Architecture Lab inspired by genesis.ai. Real-time spatial reasoning, empirical benchmarks, and interactive knowledge graph." />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg-void: #020408;
      --bg-surface: rgba(5, 12, 28, 0.75);
      --bg-card: rgba(8, 18, 40, 0.6);
      --cyan: #00F0FF;
      --cyan-glow: rgba(0, 240, 255, 0.35);
      --violet: #A855F7;
      --violet-glow: rgba(168, 85, 247, 0.35);
      --emerald: #10B981;
      --rose: #F43F5E;
      --text-hi: #FFFFFF;
      --text-mid: #94A3B8;
      --text-dim: #475569;
      --border-hud: rgba(0, 240, 255, 0.2);
      --border-card: rgba(255, 255, 255, 0.08);
      --mono: 'JetBrains Mono', monospace;
      --display: 'Space Grotesk', system-ui, sans-serif;
      --sans: 'Inter', system-ui, sans-serif;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      background: var(--bg-void);
      color: var(--text-hi);
      font-family: var(--sans);
      min-height: 100vh;
      overflow-x: hidden;
      scroll-behavior: smooth;
      font-size: 15px;
    }

    /* CYBER HUD BACKGROUND MATRIX */
    .genesis-bg-matrix {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background: 
        radial-gradient(circle at 50% 0%, rgba(0, 240, 255, 0.12) 0%, transparent 55%),
        radial-gradient(circle at 85% 60%, rgba(168, 85, 247, 0.08) 0%, transparent 50%),
        linear-gradient(to right, rgba(0, 240, 255, 0.02) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 240, 255, 0.02) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 48px 48px, 48px 48px;
    }

    /* TOP CORNER HUD BRACKETS */
    .hud-bracket {
      position: fixed;
      width: 24px;
      height: 24px;
      pointer-events: none;
      z-index: 99;
      border-color: var(--cyan);
      opacity: 0.5;
    }
    .hud-tl { top: 12px; left: 12px; border-top: 2px solid; border-left: 2px solid; }
    .hud-tr { top: 12px; right: 12px; border-top: 2px solid; border-right: 2px solid; }
    .hud-bl { bottom: 12px; left: 12px; border-bottom: 2px solid; border-left: 2px solid; }
    .hud-br { bottom: 12px; right: 12px; border-bottom: 2px solid; border-right: 2px solid; }

    /* HUD NAV BAR */
    .genesis-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(2, 4, 8, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-hud);
    }
    .nav-inner {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0.85rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }
    .brand-cube {
      width: 20px;
      height: 20px;
      border: 2px solid var(--cyan);
      box-shadow: 0 0 10px var(--cyan-glow);
      position: relative;
      transform: rotate(45deg);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .brand-cube::after {
      content: '';
      width: 6px;
      height: 6px;
      background: #FFFFFF;
      box-shadow: 0 0 6px #FFFFFF;
    }
    .brand-name {
      font-family: var(--display);
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #FFFFFF;
    }
    .brand-tag {
      font-family: var(--mono);
      font-size: 0.58rem;
      font-weight: 800;
      color: var(--cyan);
      background: rgba(0, 240, 255, 0.1);
      border: 1px solid var(--border-hud);
      padding: 0.12rem 0.5rem;
      border-radius: 4px;
      letter-spacing: 0.08em;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.75rem;
    }
    .nav-lk {
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: var(--text-mid);
      text-decoration: none;
      text-transform: uppercase;
      transition: all 0.2s;
    }
    .nav-lk:hover {
      color: var(--cyan);
      text-shadow: 0 0 8px var(--cyan-glow);
    }

    .nav-lk-mobile { display: none; }
    .nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 0 9px;
      background: rgba(0, 240, 255, 0.06);
      border: 1px solid var(--border-hud);
      border-radius: 4px;
      cursor: pointer;
    }
    .nav-toggle span { display: block; height: 1.5px; width: 100%; background: var(--cyan); transition: transform .2s, opacity .2s; }
    .nav-toggle.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .nav-toggle.open span:nth-child(2) { opacity: 0; }
    .nav-toggle.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .btn-canonical-switch {
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 700;
      color: var(--text-mid);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-card);
      padding: 0.45rem 0.85rem;
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .btn-canonical-switch:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #FFFFFF;
      border-color: rgba(255, 255, 255, 0.2);
    }

    /* WRAPPER */
    .genesis-wrap {
      max-width: 1320px;
      margin: 0 auto;
      padding: 3rem 2rem 6rem;
      position: relative;
      z-index: 1;
    }

    /* ========================================================
       HERO: GENESIS DECK
       ======================================================== */
    .genesis-hero {
      padding: 4rem 0 3.5rem;
      border-bottom: 1px solid var(--border-card);
      margin-bottom: 4rem;
      position: relative;
    }

    .hero-telemetry-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.3rem 0.85rem;
      background: rgba(0, 240, 255, 0.08);
      border: 1px solid var(--border-hud);
      border-radius: 4px;
      color: var(--cyan);
      font-weight: 700;
    }
    .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 10px var(--cyan);
      animation: pulse 1.8s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }
    .coords-txt {
      color: var(--text-dim);
    }

    .hero-title {
      font-family: var(--display);
      font-size: clamp(2.8rem, 6.2vw, 5.2rem);
      font-weight: 900;
      line-height: 1.02;
      letter-spacing: -0.04em;
      text-transform: uppercase;
      margin-bottom: 1.75rem;
      max-width: 1040px;
    }
    .title-gradient {
      background: linear-gradient(135deg, #FFFFFF 20%, var(--cyan) 65%, var(--violet) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .hero-question {
      font-family: var(--display);
      font-size: clamp(1.25rem, 2.4vw, 1.85rem);
      line-height: 1.4;
      font-weight: 500;
      color: #F1F5F9;
      margin-bottom: 1.35rem;
      max-width: 880px;
    }

    .hero-lead-desc {
      font-size: 1.15rem;
      line-height: 1.75;
      color: var(--text-mid);
      max-width: 820px;
      margin-bottom: 1.75rem;
    }

    .hero-punchline-cyber {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background: rgba(0, 240, 255, 0.05);
      border-left: 3px solid var(--cyan);
      padding: 0.65rem 1.25rem;
      border-radius: 0 6px 6px 0;
      font-family: var(--mono);
      font-size: 0.95rem;
      font-weight: 700;
      color: #FFFFFF;
      margin-bottom: 2.5rem;
      border-top: 1px solid rgba(0, 240, 255, 0.1);
      border-bottom: 1px solid rgba(0, 240, 255, 0.1);
      border-right: 1px solid rgba(0, 240, 255, 0.1);
    }

    .hero-cta-deck {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .btn-cyber-primary {
      background: var(--cyan);
      color: #020408;
      font-family: var(--mono);
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      padding: 0.85rem 2rem;
      border-radius: 4px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 0 24px var(--cyan-glow);
      transition: all 0.2s;
      position: relative;
    }
    .btn-cyber-primary:hover {
      background: #FFFFFF;
      box-shadow: 0 0 32px rgba(255, 255, 255, 0.6);
      transform: translateY(-2px);
    }
    .btn-cyber-secondary {
      background: transparent;
      color: #FFFFFF;
      border: 1px solid var(--border-hud);
      font-family: var(--mono);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 0.85rem 1.85rem;
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-cyber-secondary:hover {
      background: rgba(0, 240, 255, 0.08);
      border-color: var(--cyan);
      box-shadow: 0 0 16px var(--cyan-glow);
    }

    /* TELEMETRY HUD TILES */
    .telemetry-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-top: 2rem;
    }
    .hud-tile {
      background: var(--bg-surface);
      border: 1px solid var(--border-card);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      position: relative;
      overflow: hidden;
    }
    .hud-tile::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(to right, var(--cyan), transparent);
    }
    .tile-val {
      font-family: var(--display);
      font-size: 1.85rem;
      font-weight: 900;
      color: #FFFFFF;
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 0.4rem;
    }
    .tile-lbl {
      font-family: var(--mono);
      font-size: 0.6rem;
      color: var(--text-mid);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* ========================================================
       INTERACTIVE KNOWLEDGE GRAPH HUD SECTION
       ======================================================== */
    .genesis-graph-section {
      margin-bottom: 5.5rem;
    }
    .sec-kicker-cyber {
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      color: var(--cyan);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }
    .sec-title-cyber {
      font-family: var(--display);
      font-size: clamp(2rem, 3.4vw, 2.75rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      color: #FFFFFF;
      margin-bottom: 0.65rem;
    }
    .sec-desc-cyber {
      font-size: 0.95rem;
      color: var(--text-mid);
      max-width: 720px;
      line-height: 1.6;
      margin-bottom: 1.75rem;
    }

    /* ========================================================
       THREE CORE PATHWAYS (TOOLS, WORKFLOWS, EXPERIMENTS)
       ======================================================== */
    .pathways-section {
      margin-bottom: 5.5rem;
    }
    .pathways-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
    .pathway-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      padding: 2.25rem 2rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }
    .pathway-card:hover {
      transform: translateY(-4px);
      border-color: var(--border-hud);
      box-shadow: 0 12px 32px var(--cyan-glow);
    }
    .pw-badge {
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 800;
      color: var(--cyan);
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
    }
    .pw-title {
      font-family: var(--display);
      font-size: 1.85rem;
      font-weight: 900;
      color: #FFFFFF;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }
    .pw-headline {
      font-size: 1.05rem;
      font-weight: 600;
      color: #E2E8F0;
      line-height: 1.45;
      margin-bottom: 0.85rem;
    }
    .pw-desc {
      font-size: 0.88rem;
      color: var(--text-mid);
      line-height: 1.65;
      margin-bottom: 1.75rem;
    }
    .pw-link {
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--cyan);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      letter-spacing: 0.06em;
    }

    /* ========================================================
       FEATURED DOSSIER HERO CARD (WHERE AI WORKS IN AEC)
       ======================================================== */
    .genesis-dossier {
      background: linear-gradient(135deg, rgba(8, 18, 40, 0.9) 0%, rgba(4, 10, 24, 0.95) 100%);
      border: 1px solid var(--border-hud);
      box-shadow: 0 16px 48px rgba(0, 240, 255, 0.08);
      border-radius: 16px;
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      overflow: hidden;
      margin-bottom: 4rem;
    }
    .dossier-left-hud {
      padding: 3rem 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .dossier-meta-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }
    .dossier-title-hud {
      font-family: var(--display);
      font-size: clamp(1.85rem, 2.8vw, 2.4rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      color: #FFFFFF;
      line-height: 1.15;
      margin-bottom: 1rem;
    }
    .dossier-desc-hud {
      font-size: 0.98rem;
      line-height: 1.7;
      color: var(--text-mid);
      margin-bottom: 1.75rem;
    }

    .telemetry-bars-box {
      background: rgba(2, 4, 8, 0.8);
      border: 1px solid var(--border-card);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 2rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .tb-row {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .tb-header {
      display: flex;
      justify-content: space-between;
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--text-mid);
    }
    .tb-header b {
      color: var(--cyan);
    }
    .tb-track {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 9999px;
      overflow: hidden;
    }
    .tb-fill {
      height: 100%;
      background: linear-gradient(to right, var(--cyan), var(--violet));
      border-radius: 9999px;
      box-shadow: 0 0 10px var(--cyan-glow);
    }

    .dossier-right-hud {
      background: radial-gradient(circle at center, rgba(168, 85, 247, 0.2) 0%, rgba(0, 240, 255, 0.05) 60%, transparent 100%);
      border-left: 1px solid var(--border-card);
      padding: 3rem 2.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .inquiry-hologram {
      background: rgba(2, 4, 8, 0.8);
      border: 1px solid var(--border-hud);
      border-radius: 12px;
      padding: 2rem;
      box-shadow: 0 12px 32px var(--cyan-glow);
      backdrop-filter: blur(16px);
      width: 100%;
    }
    .inquiry-quote {
      font-family: var(--display);
      font-size: 1.15rem;
      line-height: 1.55;
      color: #FFFFFF;
      font-style: italic;
      margin-bottom: 1.5rem;
    }
    .tech-stack-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      font-family: var(--mono);
      font-size: 0.6rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-card);
    }
    .tech-chip {
      background: rgba(0, 240, 255, 0.1);
      border: 1px solid var(--border-hud);
      padding: 0.18rem 0.55rem;
      border-radius: 4px;
      color: var(--cyan);
    }

    /* ========================================================
       BEYOND THE ORDINARY: CLOSING PORTAL
       ======================================================== */
    .genesis-closing {
      margin-bottom: 4rem;
      background: linear-gradient(135deg, rgba(8, 18, 40, 0.95), rgba(2, 4, 8, 0.98));
      border: 1px solid var(--border-hud);
      border-radius: 20px;
      padding: 5rem 3rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 20px 60px var(--cyan-glow);
    }
    .closing-glow {
      position: absolute;
      top: -120px;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 350px;
      background: radial-gradient(circle, var(--cyan-glow) 0%, var(--violet-glow) 50%, transparent 80%);
      filter: blur(60px);
      pointer-events: none;
    }
    .closing-kicker {
      font-family: var(--mono);
      font-size: 0.68rem;
      font-weight: 800;
      color: var(--cyan);
      letter-spacing: 0.15em;
      margin-bottom: 1rem;
    }
    .closing-title {
      font-family: var(--display);
      font-size: clamp(2.4rem, 4.8vw, 3.8rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      margin-bottom: 1.25rem;
      color: #FFFFFF;
    }
    .closing-desc {
      font-size: 1.2rem;
      color: var(--text-mid);
      max-width: 680px;
      margin: 0 auto 2.5rem;
      line-height: 1.6;
    }

    /* FOOTER */
    .genesis-footer {
      border-top: 1px solid var(--border-card);
      padding: 3rem 2rem 2.5rem;
      background: var(--bg-void);
      font-family: var(--mono);
      font-size: 0.68rem;
      color: var(--text-dim);
    }
    .footer-inner {
      max-width: 1320px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .footer-brand {
      color: var(--text-mid);
      font-weight: 700;
    }

    @media (max-width: 1024px) {
      .pathways-grid { grid-template-columns: 1fr; }
      .telemetry-grid { grid-template-columns: repeat(2, 1fr); }
      .genesis-dossier { grid-template-columns: 1fr; }
      .dossier-right-hud { border-left: none; border-top: 1px solid var(--border-card); }
    }
    @media (max-width: 768px) {
      .nav-inner { padding: 0.75rem 1.25rem; gap: 0.75rem; position: relative; }
      .brand-tag { display: none; }
      .brand-name { font-size: 1rem; }
      .nav-toggle { display: inline-flex; margin-left: auto; }
      .nav-lk-mobile { display: none; }
    .nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 0 9px;
      background: rgba(0, 240, 255, 0.06);
      border: 1px solid var(--border-hud);
      border-radius: 4px;
      cursor: pointer;
    }
    .nav-toggle span { display: block; height: 1.5px; width: 100%; background: var(--cyan); transition: transform .2s, opacity .2s; }
    .nav-toggle.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .nav-toggle.open span:nth-child(2) { opacity: 0; }
    .nav-toggle.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    .nav-actions { display: none; }
      .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding: 0.5rem 1.25rem 1rem;
        background: rgba(2, 4, 8, 0.97);
        border-bottom: 1px solid var(--border-hud);
      }
      .nav-links.open { display: flex; }
      .nav-links .nav-lk { padding: 0.9rem 0; border-bottom: 1px solid var(--border-card); font-size: 0.78rem; }
      .nav-links .nav-lk-mobile { display: block; color: var(--cyan); }
      .telemetry-grid { grid-template-columns: 1fr; }
      .hero-title { font-size: 2.6rem; }
      .genesis-wrap { padding: 2rem 1.25rem 4rem; }
    }
  </style>
</head>
<body>

  <!-- CYBER HUD BACKGROUND -->
  <div class="genesis-bg-matrix" aria-hidden="true"></div>

  <!-- HUD CORNER BRACKETS -->
  <div class="hud-bracket hud-tl" aria-hidden="true"></div>
  <div class="hud-bracket hud-tr" aria-hidden="true"></div>
  <div class="hud-bracket hud-bl" aria-hidden="true"></div>
  <div class="hud-bracket hud-br" aria-hidden="true"></div>

  <!-- HUD NAVIGATION -->
  <header class="genesis-nav">
    <div class="nav-inner">
      <a href="/genesis" class="nav-brand">
        <div class="brand-cube"></div>
        <span class="brand-name">AI Architecture Lab</span>
        <span class="brand-tag">GENESIS HUD</span>
      </a>

      <nav class="nav-links" id="genesis-nav-links" aria-label="Cyber Navigation">
        <a href="#knowledge-graph" class="nav-lk">Neural Graph</a>
        <a href="#pathways" class="nav-lk">Tools</a>
        <a href="#pathways" class="nav-lk">Workflows</a>
        <a href="#pathways" class="nav-lk">Experiments</a>
        <a href="/experiments/where-ai-actually-works-in-aec" class="nav-lk">Benchmark EXP_004</a>
        <a href="/" class="nav-lk nav-lk-mobile">&larr; Ver Versión Editorial</a>
      </nav>

      <div class="nav-actions">
        <a href="/" class="btn-canonical-switch" title="Cambiar a la versión canónica Paper Minimalist">
          &larr; Ver Versión Editorial
        </a>
      </div>

      <button type="button" class="nav-toggle" id="genesis-nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="genesis-nav-links">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main class="genesis-wrap">
    
    <!-- HERO: GENESIS DECK -->
    <section class="genesis-hero">
      <div class="hero-telemetry-banner">
        <div class="status-badge">
          <span class="pulse-dot"></span>
          <span>SYSTEM ONLINE // ETSAM COMPUTE NODE // MADRID</span>
        </div>
        <div class="coords-txt">
          <span>LAT 40.4168° N</span> &bull; <span>LON 3.7038° W</span> &bull; <span>CYCLE 2026.4</span>
        </div>
      </div>

      <h1 class="hero-title">
        Architecture is changing.<br />
        <span class="title-gradient">Make something new.</span>
      </h1>

      <p class="hero-question">
        What if AI could change the way you design, the tools you use, and the ideas you bring to life?
      </p>

      <p class="hero-lead-desc">
        Explore new tools, experiment with emerging technologies, and discover new ways to approach architectural design through verifiable spatial computation.
      </p>

      <div class="hero-punchline-cyber">
        <span>&gt;&gt;</span>
        <span>Less repetition. More exploration. New ways to create.</span>
      </div>

      <div class="hero-cta-deck">
        <a href="#pathways" class="btn-cyber-primary">
          INITIALIZE AI TOOLS &rarr;
        </a>
        <a href="#knowledge-graph" class="btn-cyber-secondary">
          EXPLORE NEURAL GRAPH
        </a>
      </div>

      <!-- TELEMETRY HUD TILES -->
      <div class="telemetry-grid">
        <div class="hud-tile">
          <div class="tile-val" style="color:var(--cyan);">94.2%</div>
          <div class="tile-lbl">Building Code &amp; Zoning RAG</div>
        </div>
        <div class="hud-tile">
          <div class="tile-val" style="color:var(--violet);">88.0%</div>
          <div class="tile-lbl">Parametric Python Synthesis</div>
        </div>
        <div class="hud-tile">
          <div class="tile-val" style="color:var(--rose);">0.0%</div>
          <div class="tile-lbl">3D Spatial Topology Direct Edit</div>
        </div>
        <div class="hud-tile">
          <div class="tile-val" style="color:var(--emerald);">$0.00</div>
          <div class="tile-lbl">Recurring Serverless Cost</div>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE KNOWLEDGE GRAPH (INSPIRADO EN SEUNGHYUK.COM) -->
    <section class="genesis-graph-section" id="knowledge-graph">
      <div class="sec-kicker-cyber">
        <span>[ 01 // NEURAL TOPOLOGY ]</span>
      </div>
      <h2 class="sec-title-cyber">Interactive Knowledge Graph</h2>
      <p class="sec-desc-cyber">
        Esquema dinámico de conexiones conceptuales inspirado en <a href="https://seunghyuk.com/?ref=siteinspire" target="_blank" rel="noopener" style="color:var(--cyan);text-decoration:underline;">seunghyuk.com</a>. Arrastra los nodos, despliega relaciones complejas y haz clic en cualquier investigación para acceder al dossier completo.
      </p>

      <!-- Knowledge Graph Component with Genesis Theme -->
      <KnowledgeGraph theme="genesis" height="640px" showControls={true} />
    </section>

    <!-- THREE CORE PATHWAYS (TOOLS, WORKFLOWS, EXPERIMENTS) -->
    <section class="pathways-section" id="pathways">
      <div class="sec-kicker-cyber">
        <span>[ 02 // SYSTEM MODULES ]</span>
      </div>
      <h2 class="sec-title-cyber">Explore What's Possible</h2>
      <p class="sec-desc-cyber">
        Three pathways to rethink how architectural work gets done, from automated micro-tools to connected workflows and frontier stress-testing.
      </p>

      <div class="pathways-grid">
        <!-- 1. TOOLS -->
        <article class="pathway-card">
          <div>
            <div class="pw-badge">01 // TOOLS &amp; APPS</div>
            <h3 class="pw-title">TOOLS</h3>
            <p class="pw-headline">New tools to rethink how architectural work gets done.</p>
            <p class="pw-desc">Small applications, utilities, and algorithmic prototypes applying artificial intelligence directly to concrete architectural tasks.</p>
          </div>
          <a href="/work" class="pw-link">ACCESS TOOLS &rarr;</a>
        </article>

        <!-- 2. WORKFLOWS -->
        <article class="pathway-card">
          <div>
            <div class="pw-badge">02 // INTEGRATION</div>
            <h3 class="pw-title">WORKFLOWS</h3>
            <p class="pw-headline">Smarter ways to connect ideas, processes, and technology.</p>
            <p class="pw-desc">Practical pipelines bridging foundation models, Grasshopper, Speckle, and BIM environments to eliminate repetitive overhead.</p>
          </div>
          <a href="/resources" class="pw-link">DEPLOY WORKFLOWS &rarr;</a>
        </article>

        <!-- 3. EXPERIMENTS -->
        <article class="pathway-card">
          <div>
            <div class="pw-badge">03 // FRONTIER LAB</div>
            <h3 class="pw-title">EXPERIMENTS</h3>
            <p class="pw-headline">New possibilities at the intersection of architecture and AI.</p>
            <p class="pw-desc">Rigorous stress-testing, topological benchmarks, and empirical evaluations examining where frontier models excel and where they fail.</p>
          </div>
          <a href="/experiments" class="pw-link">INSPECT EXPERIMENTS &rarr;</a>
        </article>
      </div>
    </section>

    <!-- FEATURED BENCHMARK DOSSIER -->
    {featuredExp && (
      <section class="genesis-dossier" id="featured-dossier">
        <div class="dossier-left-hud">
          <div>
            <div class="dossier-meta-row">
              <span class="status-badge" style="color:var(--emerald);border-color:rgba(16,185,129,0.3);background:rgba(16,185,129,0.1);">
                DOSSIER EXP_004 &bull; PEER-REVIEWED
              </span>
              <span style="font-family:var(--mono);font-size:0.62rem;color:var(--text-dim);">
                DOI: {featuredExp.data.doi || '10.1038/arch.ai.2026.042'}
              </span>
            </div>

            <h3 class="dossier-title-hud">
              <a href={`/experiments/${featuredExp.id}`} style="color:inherit;text-decoration:none;">
                {featuredExp.data.title}
              </a>
            </h3>

            <p class="dossier-desc-hud">
              Empirical benchmark measuring frontier LLMs across 9 architectural domains. Mapping with mathematical rigor where AI accelerates practice and where it encounters an insurmountable geometric barrier.
            </p>

            <div class="telemetry-bars-box">
              <div class="tb-row">
                <div class="tb-header">
                  <span>Building Code &amp; Zoning RAG</span>
                  <b>94.2%</b>
                </div>
                <div class="tb-track"><div class="tb-fill" style="width: 94%;"></div></div>
              </div>
              <div class="tb-row">
                <div class="tb-header">
                  <span>Grasshopper Parametric Python</span>
                  <b>88.0%</b>
                </div>
                <div class="tb-track"><div class="tb-fill" style="width: 88%;"></div></div>
              </div>
              <div class="tb-row">
                <div class="tb-header">
                  <span>Multi-drawing Coordination</span>
                  <b style="color:var(--rose);">0.0% (Structural Failure)</b>
                </div>
                <div class="tb-track"><div class="tb-fill" style="width: 4%; background:var(--rose);"></div></div>
              </div>
            </div>
          </div>

          <div>
            <a href={`/experiments/${featuredExp.id}`} class="btn-cyber-primary">
              EXPLORE TECHNICAL DOSSIER &rarr;
            </a>
          </div>
        </div>

        <div class="dossier-right-hud">
          <div class="inquiry-hologram">
            <div style="font-family:var(--mono);font-size:0.6rem;color:var(--cyan);margin-bottom:0.75rem;letter-spacing:0.1em;">
              // CORE INQUIRY PROTOCOL
            </div>
            <p class="inquiry-quote">
              &ldquo;Why does frontier AI struggle with authentic spatial reasoning in AEC, and in which specific computational inflection points does it deliver undeniable structural value?&rdquo;
            </p>
            <div class="tech-stack-row">
              <span style="color:var(--text-mid);">STACK:</span>
              <span class="tech-chip">GPT-4o</span>
              <span class="tech-chip">Claude 3.5</span>
              <span class="tech-chip">IFC 4.3</span>
              <span class="tech-chip">Speckle</span>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- CLOSING PORTAL -->
    <section class="genesis-closing">
      <div class="closing-glow"></div>
      <div style="position:relative;z-index:2;">
        <div class="closing-kicker">AI ARCHITECTURE LAB // HORIZON 2026</div>
        <h2 class="closing-title">Beyond the ordinary.</h2>
        <p class="closing-desc">
          A space to explore, build, and discover what's next in architecture through computational rigor and open research.
        </p>
        <a href="#knowledge-graph" class="btn-cyber-primary">
          INITIALIZE NEURAL EXPLORATION &rarr;
        </a>
      </div>
    </section>

  </main>

  <footer class="genesis-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        AI ARCHITECTURE LAB &bull; Jorge Ludeña (ETSAM) &bull; Genesis Edition 2026.4
      </div>
      <div>
        <span>Open Science &bull; Static Serverless Core &bull; Cost: $0.00 USD/mo</span>
      </div>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var btn = document.getElementById('genesis-nav-toggle');
      var links = document.getElementById('genesis-nav-links');
      if (!btn || !links) return;
      function setOpen(open) {
        links.classList.toggle('open', open);
        btn.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      }
      btn.addEventListener('click', function () { setOpen(!links.classList.contains('open')); });
      links.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
      window.addEventListener('resize', function () { if (window.innerWidth > 768) setOpen(false); });
    })();
  </script>

</body>
</html>
