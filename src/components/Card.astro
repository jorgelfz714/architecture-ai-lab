---
interface Props {
  title: string;
  description: string;
  date: string;
  href: string;
  category: string;
  tags?: string[];
  readingTime?: string;
  idCode?: string;
  isFeatured?: boolean;
  coverImage?: string;
}

const { 
  title, 
  description, 
  date, 
  href, 
  category, 
  tags = [], 
  readingTime = "10 min read",
  idCode,
  isFeatured = false,
  coverImage
} = Astro.props;
---

<article class={`auralis-card ${isFeatured ? 'featured' : ''}`}>
  {coverImage && (
    <div class="card-visual-header">
      <a href={href} class="visual-link" tabindex="-1" aria-hidden="true">
        <img 
          src={coverImage} 
          alt={`Gráfico ilustrativo de ${title}`} 
          loading="lazy" 
          class="card-graphic-img" 
        />
        <div class="visual-overlay"></div>
      </a>
      <span class="visual-badge">SPEC // GRAPHIC</span>
    </div>
  )}

  <div class="card-inner-body">
    <div class="card-top">
      <div class="card-meta mono">
        <span class="category-badge">{category}</span>
        {idCode && <span class="id-badge">{idCode}</span>}
        <span class="meta-sep">&bull;</span>
        <time datetime={date}>{date}</time>
        <span class="read-time">{readingTime}</span>
      </div>
      <h3 class="card-title">
        <a href={href}>{title}</a>
      </h3>
      <p class="card-desc">{description}</p>
    </div>
    
    <div class="card-bottom">
      {tags.length > 0 && (
        <div class="tag-list">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      <a href={href} class="card-arrow" aria-label={`Leer ${title}`}>
        <span>Explorar</span> &rarr;
      </a>
    </div>
  </div>
</article>

<style>
  .auralis-card {
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02);
    position: relative;
    overflow: hidden;
  }

  .auralis-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.22);
  }

  .auralis-card.featured {
    border: 1.5px solid #0D0D0D;
  }

  /* VISUAL HEADER WITH ILLUSTRATIVE GRAPHIC */
  .card-visual-header {
    position: relative;
    width: 100%;
    height: 180px;
    background: #0E131F;
    overflow: hidden;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .visual-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-graphic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .auralis-card:hover .card-graphic-img {
    transform: scale(1.04);
  }

  .visual-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 60%, rgba(0,0,0,0.3) 100%);
    pointer-events: none;
  }

  .visual-badge {
    position: absolute;
    top: 10px;
    right: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.18rem 0.45rem;
    background: rgba(0, 0, 0, 0.65);
    color: #FFFFFF;
    backdrop-filter: blur(4px);
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* CARD INNER BODY */
  .card-inner-body {
    padding: 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
  }

  .card-top { margin-bottom: 1.25rem; }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.62rem;
    color: #686862;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
    letter-spacing: 0.04em;
  }

  .category-badge {
    text-transform: uppercase;
    color: #0D0D0D;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.045);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .id-badge {
    font-weight: 700;
    color: #059669;
    background: rgba(5, 150, 105, 0.08);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .meta-sep { color: #989890; }
  .read-time { margin-left: auto; color: #989890; font-size: 0.6rem; }

  .card-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #0D0D0D;
    margin-bottom: 0.55rem;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }

  .card-title a:hover {
    color: #2563EB;
  }

  .card-desc {
    font-size: 0.86rem;
    line-height: 1.62;
    color: #383834;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    gap: 0.75rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    color: #686862;
    background: #EFEFEA;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .card-arrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: #0D0D0D;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: transform 0.15s, color 0.15s;
  }

  .card-arrow:hover {
    transform: translateX(3px);
    color: #2563EB;
  }
</style>
