---
interface Props {
  title: string;
  description: string;
  date: string;
  href: string;
  category: string;
  tags?: string[];
  readingTime?: string;
  idCode?: string;
  isFeatured?: boolean;
}

const { 
  title, 
  description, 
  date, 
  href, 
  category, 
  tags = [], 
  readingTime = "10 min read",
  idCode,
  isFeatured = false 
} = Astro.props;
---

<article class={`andmade-card ${isFeatured ? 'featured' : ''}`}>
  <div class="card-inner">
    <div class="card-header">
      <div class="card-id-block">
        <span class="card-category">{category}</span>
        {idCode && <span class="card-id-code">{idCode}</span>}
      </div>
      <div class="card-meta-right">
        <time datetime={date}>{date}</time>
        <span class="meta-sep">&bull;</span>
        <span>{readingTime}</span>
      </div>
    </div>

    <div class="card-main">
      <h3 class="card-title">
        <a href={href}>{title}</a>
      </h3>
      <p class="card-desc">{description}</p>
    </div>

    <div class="card-footer">
      {tags.length > 0 && (
        <div class="card-tags">
          {tags.map((tag) => (
            <span class="tech-chip">{tag}</span>
          ))}
        </div>
      )}
      <a href={href} class="card-action" aria-label={`Read ${title}`}>
        <span>Open Record</span>
        <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</article>

<style>
  .andmade-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.15s ease, border-color 0.15s ease;
    min-height: 320px;
    position: relative;
  }

  .andmade-card:hover {
    background: #FAF9F6;
    border-color: var(--border-hover);
  }

  .card-inner {
    padding: clamp(1.4rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .card-id-block {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .card-category {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
  }

  .card-id-code {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .card-meta-right {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .card-main {
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--accent-blue);
  }

  .card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .card-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tech-chip {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .card-action {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .card-action:hover {
    transform: translateX(2px);
    opacity: 0.75;
  }

  .arrow {
    font-weight: 800;
  }
</style>
