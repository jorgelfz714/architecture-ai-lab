---
interface Props {
  title: string;
  description: string;
  date: string;
  href: string;
  category: string;
  tags?: string[];
  readingTime?: string;
  idCode?: string;
  isFeatured?: boolean;
  coverImage?: string;
}

const {
  title,
  description,
  date,
  href,
  category,
  tags = [],
  readingTime = "10 min read",
  idCode,
  isFeatured = false,
  coverImage
} = Astro.props;
---

<article class={`auralis-card g-card-item ${isFeatured ? 'featured' : ''}`}>
  <div class="g-card-ticks" aria-hidden="true">
    <span class="g-tick-mark"></span>
    <span class="g-tick-mark"></span>
  </div>

  {coverImage && (
    <a href={href} class="card-visual-header" aria-label={`Abrir ${title}`}>
      <img
        src={coverImage}
        alt={`Gráfico ilustrativo de ${title}`}
        loading="lazy"
        class="card-graphic-img"
      />
      <span class="visual-hover-cta">Open Dossier &rarr;</span>
    </a>
  )}

  <div class="card-inner-body">
    <div class="card-top">
      <div class="card-meta mono">
        <span class="category-badge">{category}</span>
        {idCode && <span class="id-badge">{idCode}</span>}
        <span class="meta-sep">&middot;</span>
        <time datetime={date}>{date}</time>
        <span class="read-time">{readingTime}</span>
      </div>
      <h3 class="card-title">
        <a href={href}>{title}</a>
      </h3>
      <p class="card-desc">{description}</p>
    </div>

    <div class="card-bottom">
      {tags.length > 0 && (
        <div class="tag-list">
          {tags.slice(0, 3).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      <a href={href} class="card-arrow" aria-label={`Leer ${title}`}>
        <span>Read</span>
      </a>
    </div>
  </div>
</article>

<style>
  .g-card-item {
    background: #F6F6F4;
    border: 0;
    border-radius: 16px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    position: relative;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
  }

  .g-card-item:hover {
    transform: translateY(-2px);
    background: #F1F1EE;
  }

  .g-card-item.featured {
    background: #DEE8EB;
  }
  .g-card-item.featured:hover {
    background: #D4E1E5;
  }

  .g-card-ticks {
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }
  .g-tick-mark {
    display: inline-block;
    width: 10px;
    height: 1px;
    background: #1A1D34;
    opacity: 0.55;
  }

  /* VISUAL HEADER WITH NANO BANANA COVER */
  .card-visual-header {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    background: #E8E8E4;
    overflow: hidden;
  }

  .card-graphic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .g-card-item:hover .card-graphic-img {
    transform: scale(1.03);
  }

  .visual-hover-cta {
    position: absolute;
    bottom: 10px;
    left: 10px;
    height: 24px;
    padding: 0 10px;
    border-radius: 6px;
    background: rgba(26, 29, 52, 0.82);
    backdrop-filter: blur(7px);
    color: #FFFFFF;
    font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace;
    font-size: 0.656rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .g-card-item:hover .visual-hover-cta {
    opacity: 1;
    transform: translateY(0);
  }

  /* CARD INNER BODY */
  .card-inner-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    gap: 16px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace;
    font-size: 0.656rem;
    font-weight: 500;
    color: #8A8A8A;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .category-badge {
    color: #1A1D34;
    font-weight: 500;
  }

  .id-badge {
    color: #1A1D34;
    background: rgba(26, 29, 52, 0.08);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .meta-sep { color: #8A8A8A; }
  .read-time { margin-left: auto; color: #8A8A8A; }

  .card-title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.045em;
    color: #1A1D34;
    margin-bottom: 8px;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
  }

  .card-desc {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.42;
    letter-spacing: -0.02em;
    color: #5C5F6E;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid #DCDCD6;
    gap: 10px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .tag {
    font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: #5C5F6E;
    background: #EBEBE8;
    padding: 2px 7px;
    border-radius: 4px;
  }

  .card-arrow {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: 6px;
    background: #282828;
    color: #FFFFFF;
    font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace;
    font-size: 0.656rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: padding-right 0.3s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
  }

  .card-arrow::after {
    content: '→';
    position: absolute;
    right: 9px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.25s ease 0.06s, transform 0.25s ease 0.06s;
  }

  .card-arrow:hover {
    background: #141414;
    padding-right: 26px;
  }

  .card-arrow:hover::after {
    opacity: 1;
    transform: translateX(0);
  }
</style>
