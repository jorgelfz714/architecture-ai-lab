---
import { getCollection } from 'astro:content';

interface Props {
  theme?: 'obsidian' | 'paper' | 'genesis';
  height?: string;
  showControls?: boolean;
  offsetRight?: boolean;
}

const {
  theme = 'obsidian',
  height = '620px',
  showControls = true,
  offsetRight = false,
} = Astro.props;

// Fetch all collections dynamically so the graph updates automatically with new posts
const experiments = await getCollection('experiments');
const work = await getCollection('work');
const notes = await getCollection('notes');
const resources = await getCollection('resources');

// Build live graph data
const graphData = {
  root: {
    id: 'root',
    label: 'AI ARCHITECTURE LAB',
    type: 'root',
    desc: 'Digital Research Laboratory // Directed by Jorge Ludeña (ETSAM)',
    url: '/'
  },
  categories: [
    { id: 'cat-tools', label: 'TOOLS', category: 'work', desc: 'Algorithmic applications & spatial utilities' },
    { id: 'cat-workflows', label: 'WORKFLOWS', category: 'resources', desc: 'Connected computational pipelines (GH, Ladybug, Python)' },
    { id: 'cat-experiments', label: 'EXPERIMENTS', category: 'experiments', desc: 'Empirical stress-testing & topological benchmarks' },
    { id: 'cat-notes', label: 'MANIFESTO', category: 'notes', desc: 'Epistemology, physical truth & lab manifestos' }
  ],
  posts: [
    ...experiments.map(e => ({
      id: `exp-${e.id}`,
      label: e.data.title.length > 30 ? e.data.title.slice(0, 28) + '…' : e.data.title,
      fullTitle: e.data.title,
      category: 'experiments',
      catId: 'cat-experiments',
      url: `/experiments/${e.id}`,
      desc: e.data.description,
      tags: e.data.tags || [],
      status: e.data.status || 'Published'
    })),
    ...work.map(w => ({
      id: `work-${w.id}`,
      label: w.data.title.length > 30 ? w.data.title.slice(0, 28) + '…' : w.data.title,
      fullTitle: w.data.title,
      category: 'work',
      catId: 'cat-tools',
      url: `/work/${w.id}`,
      desc: w.data.description,
      tags: w.data.tags || [],
      status: w.data.status || 'Prototype'
    })),
    ...resources.map(r => ({
      id: `res-${r.id}`,
      label: r.data.title.length > 30 ? r.data.title.slice(0, 28) + '…' : r.data.title,
      fullTitle: r.data.title,
      category: 'resources',
      catId: 'cat-workflows',
      url: `/resources/${r.id}`,
      desc: r.data.description,
      tags: r.data.tags || [],
      status: r.data.status || 'Available'
    })),
    ...notes.map(n => ({
      id: `note-${n.id}`,
      label: n.data.title.length > 30 ? n.data.title.slice(0, 28) + '…' : n.data.title,
      fullTitle: n.data.title,
      category: 'notes',
      catId: 'cat-notes',
      url: `/notes/${n.id}`,
      desc: n.data.description,
      tags: n.data.tags || [],
      status: n.data.status || 'Lab Core'
    }))
  ]
};
---

<div
  class={`kg-container theme-${theme === 'genesis' ? 'obsidian' : theme}`}
  style={`height: ${height};`}
  id="kg-wrapper"
  data-offset-right={offsetRight ? 'true' : 'false'}
>
  <!-- Interactive Canvas -->
  <canvas id="kg-canvas" class="kg-canvas" aria-label="Grafo interactivo de conocimiento de Architecture AI Lab"></canvas>

  <!-- Obsidian-style Compact Groups Filter Panel (Top-Right) -->
  {showControls && (
    <div class="kg-groups-panel" id="kg-groups-panel" aria-label="Filtros de grupos del grafo">
      <div class="kg-groups-head">
        <span class="kg-groups-dot"></span>
        <span>GRAPH VIEW // GROUPS</span>
      </div>
      <div class="kg-group-chips">
        <button type="button" class="kg-chip active" data-group="all">
          <span class="dot" style="background:#F8FAFC;"></span>All
        </button>
        <button type="button" class="kg-chip" data-group="notes">
          <span class="dot" style="background:#EA7A1C;"></span>Core
        </button>
        <button type="button" class="kg-chip" data-group="experiments">
          <span class="dot" style="background:#E04F5F;"></span>Experiments
        </button>
        <button type="button" class="kg-chip" data-group="work">
          <span class="dot" style="background:#7C9CE5;"></span>Tools
        </button>
        <button type="button" class="kg-chip" data-group="resources">
          <span class="dot" style="background:#6EE7B7;"></span>Workflows
        </button>
      </div>
    </div>
  )}

  <!-- Interactive Controls Overlay (Bottom-Right) -->
  {showControls && (
    <div class="kg-controls">
      <button type="button" class="kg-btn" id="kg-btn-theme" title="Alternar estilo visual (Obsidian / Paper)">
        <span class="icon">&#9681;</span>
        <span class="txt">Estilo: Obsidian / Paper</span>
      </button>
      <button type="button" class="kg-btn" id="kg-btn-center" title="Recentrar grafo">
        <span class="icon">&#8857;</span>
        <span class="txt">Recentrar</span>
      </button>
    </div>
  )}

  <!-- Node Hover Detail Popover -->
  <div class="kg-node-tooltip" id="kg-tooltip" style="display: none;">
    <div class="tt-kicker" id="tt-kicker">CATEGORY // EXPERIMENT</div>
    <div class="tt-title" id="tt-title">Node Title</div>
    <div class="tt-desc" id="tt-desc">Description of the node</div>
    <div class="tt-action" id="tt-action">Click para abrir investigación completa &rarr;</div>
  </div>
</div>

<!-- Embedded JSON Data for Client-side Physics Simulation -->
<script type="application/json" id="kg-data" is:inline set:html={JSON.stringify(graphData)} />

<script is:inline>
(function () {
  const wrapper = document.getElementById('kg-wrapper');
  const canvas = document.getElementById('kg-canvas');
  const tooltip = document.getElementById('kg-tooltip');
  const ttKicker = document.getElementById('tt-kicker');
  const ttTitle = document.getElementById('tt-title');
  const ttDesc = document.getElementById('tt-desc');
  const ttAction = document.getElementById('tt-action');
  const btnTheme = document.getElementById('kg-btn-theme');
  const btnCenter = document.getElementById('kg-btn-center');
  const groupChips = Array.from(document.querySelectorAll('#kg-groups-panel .kg-chip'));

  if (!canvas || !wrapper) return;

  const dataEl = document.getElementById('kg-data');
  const graphData = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
  const offsetRight = wrapper.getAttribute('data-offset-right') === 'true';

  const ctx = canvas.getContext('2d');
  let currentTheme = wrapper.classList.contains('theme-paper') ? 'paper' : 'obsidian';
  let activeGroup = 'all';

  let width = 0;
  let height = 0;
  let dpr = Math.min(window.devicePixelRatio || 1, 2);

  // Interactive real nodes + ambient Obsidian galaxy micro-nodes
  let nodes = [];
  let links = [];
  let ambientNodes = [];
  let ambientEdges = [];
  let haloDots = [];

  // Interaction state
  let hoveredNode = null;
  let draggedNode = null;
  let mouseX = 0;
  let mouseY = 0;
  let isPointerDown = false;
  let hasMovedPointer = false;
  let downX = 0;
  let downY = 0;

  // Deterministic PRNG for stable organic constellation
  function makeRng(seed) {
    let s = seed >>> 0;
    return function () {
      s = (s * 1664525 + 1013904223) >>> 0;
      return s / 4294967296;
    };
  }

  const PALETTE = {
    obsidian: {
      root: '#F8FAFC',
      notes: '#EA7A1C',
      experiments: '#E04F5F',
      work: '#7C9CE5',
      resources: '#6EE7B7',
      violet: '#A78BFA',
      amber: '#F59E0B',
      pink: '#F472B6',
      edgeBase: 'rgba(182, 54, 54, 0.24)',
      edgeBridge: 'rgba(165, 68, 76, 0.16)',
      edgeHighlight: 'rgba(248, 250, 252, 0.72)',
      label: '#E2E8F0',
      labelMuted: 'rgba(203, 213, 225, 0.58)'
    },
    paper: {
      root: '#1A1D34',
      notes: '#C25E0C',
      experiments: '#B83240',
      work: '#3B66C4',
      resources: '#1B8A62',
      violet: '#6D4CC4',
      amber: '#B4690E',
      pink: '#BE3A74',
      edgeBase: 'rgba(26, 29, 52, 0.14)',
      edgeBridge: 'rgba(26, 29, 52, 0.09)',
      edgeHighlight: 'rgba(26, 29, 52, 0.78)',
      label: '#1A1D34',
      labelMuted: 'rgba(26, 29, 52, 0.55)'
    }
  };

  function getPalette() {
    return PALETTE[currentTheme] || PALETTE.obsidian;
  }

  function getCategoryColor(cat) {
    const p = getPalette();
    return p[cat] || p.root;
  }

  function initGraphData() {
    nodes = [];
    links = [];
    ambientNodes = [];
    ambientEdges = [];
    haloDots = [];

    const rng = makeRng(2026042);
    const isDesktop = width > 768;
    const cx = (offsetRight && isDesktop) ? width * 0.59 : width * 0.5;
    const cy = height * 0.5;
    const galaxyR = isDesktop
      ? Math.min(width * (offsetRight ? 0.33 : 0.42), height * 0.43)
      : Math.min(width, height) * 0.40;

    // 1. Root Core Hub (Central pearl-white / amber heart)
    const rootNode = {
      id: graphData.root.id,
      label: graphData.root.label,
      fullTitle: 'Architecture AI Lab Hub',
      desc: graphData.root.desc,
      url: graphData.root.url,
      type: 'root',
      category: 'notes',
      radius: isDesktop ? 8 : 6.5,
      isRoot: true,
      x: cx,
      y: cy,
      baseX: cx,
      baseY: cy,
      vx: 0,
      vy: 0,
      fx: cx,
      fy: cy
    };
    nodes.push(rootNode);

    // 2. Primary Category Cluster Centers (organic Obsidian positions)
    const catCoords = {
      'cat-notes':       { ax: -0.06, ay: -0.04 }, // central orange-amber core
      'cat-experiments': { ax: -0.44, ay: -0.22 }, // upper-left crimson cluster
      'cat-tools':       { ax:  0.14, ay:  0.34 }, // lower-center periwinkle cluster
      'cat-workflows':   { ax:  0.46, ay:  0.46 }  // lower-right mint emerald cluster
    };

    const catMap = {};
    (graphData.categories || []).forEach((cat, index) => {
      const c = catCoords[cat.id] || {
        ax: Math.cos((index / 4) * Math.PI * 2) * 0.4,
        ay: Math.sin((index / 4) * Math.PI * 2) * 0.4
      };
      const x = cx + c.ax * galaxyR;
      const y = cy + c.ay * galaxyR;
      const catNode = {
        id: cat.id,
        label: cat.label,
        fullTitle: cat.label,
        desc: cat.desc,
        type: 'category',
        category: cat.category,
        radius: isDesktop ? 6.5 : 5.5,
        x, y,
        baseX: x,
        baseY: y,
        vx: 0,
        vy: 0
      };
      nodes.push(catNode);
      catMap[cat.id] = catNode;
      links.push({ source: rootNode, target: catNode, length: Math.hypot(x - cx, y - cy), strength: 0.045 });
    });

    // 3. Real Publication Leaf Nodes (automatically loaded from Astro collections)
    (graphData.posts || []).forEach((p, idx) => {
      const parentCat = catMap[p.catId] || rootNode;
      const baseAngle = Math.atan2(parentCat.y - cy, parentCat.x - cx);
      const spread = ((idx % 3) - 1) * 0.55 + (rng() - 0.5) * 0.25;
      const dist = galaxyR * (isDesktop ? 0.28 : 0.24);
      const x = parentCat.x + Math.cos(baseAngle + spread) * dist;
      const y = parentCat.y + Math.sin(baseAngle + spread) * dist;

      const postNode = {
        id: p.id,
        label: p.label,
        fullTitle: p.fullTitle,
        desc: p.desc,
        url: p.url,
        type: 'post',
        category: p.category,
        catId: p.catId,
        radius: isDesktop ? 6 : 5,
        x, y,
        baseX: x,
        baseY: y,
        vx: 0,
        vy: 0
      };
      nodes.push(postNode);
      links.push({ source: parentCat, target: postNode, length: dist, strength: 0.04 });
      links.push({ source: rootNode, target: postNode, length: Math.hypot(x - cx, y - cy), strength: 0.012 });
    });

    // 4. Dense Obsidian-Style Multi-Cluster Micro-Constellation (~220 semantic micro-nodes)
    const clusterDefs = [
      // Central dense warm-orange & white core (just like the reference image!)
      { parent: catMap['cat-notes'] || rootNode, cat: 'notes', count: isDesktop ? 76 : 44, spreadX: 0.28, spreadY: 0.18, offsetX: 0.02, offsetY: -0.02, colors: ['#EA7A1C', '#F59E0B', '#D97706', '#F8FAFC', '#FB923C'] },
      // Upper-left & lower-left crimson/coral experiments clusters
      { parent: catMap['cat-experiments'] || rootNode, cat: 'experiments', count: isDesktop ? 48 : 28, spreadX: 0.24, spreadY: 0.22, offsetX: -0.14, offsetY: 0.04, colors: ['#D94654', '#C0392B', '#EF5350', '#F472B6'] },
      { parent: catMap['cat-experiments'] || rootNode, cat: 'experiments', count: isDesktop ? 26 : 16, spreadX: 0.16, spreadY: 0.16, offsetX: -0.08, offsetY: 0.66, colors: ['#C0392B', '#D94654', '#E57373'] },
      // Lower-mid periwinkle blue Tools cluster
      { parent: catMap['cat-tools'] || rootNode, cat: 'work', count: isDesktop ? 44 : 26, spreadX: 0.22, spreadY: 0.15, offsetX: 0.04, offsetY: 0.02, colors: ['#7C9CE5', '#93C5FD', '#818CF8', '#A5B4FC'] },
      // Lower-right mint green Workflows cluster
      { parent: catMap['cat-workflows'] || rootNode, cat: 'resources', count: isDesktop ? 36 : 22, spreadX: 0.16, spreadY: 0.15, offsetX: 0.02, offsetY: 0.04, colors: ['#6EE7B7', '#34D399', '#A7F3D0', '#5EEAD4'] },
      // Upper-right violet/pink conceptual bridge cluster
      { parent: rootNode, cat: 'experiments', count: isDesktop ? 30 : 18, spreadX: 0.22, spreadY: 0.18, offsetX: 0.28, offsetY: -0.44, colors: ['#A78BFA', '#C084FC', '#F472B6', '#E2E8F0'] }
    ];

    clusterDefs.forEach((def) => {
      const startIdx = ambientNodes.length;
      for (let i = 0; i < def.count; i++) {
        // Gaussian-like radial falloff for organic density
        const u = (rng() + rng() + rng()) / 3 - 0.5;
        const v = (rng() + rng() + rng()) / 3 - 0.5;
        const ox = (def.offsetX + u * def.spreadX * 2.1) * galaxyR;
        const oy = (def.offsetY + v * def.spreadY * 2.1) * galaxyR;
        const col = def.colors[Math.floor(rng() * def.colors.length)];
        const r = 1.3 + Math.pow(rng(), 2.2) * 3.1;

        ambientNodes.push({
          parent: def.parent,
          cat: def.cat,
          ox, oy,
          x: def.parent.x + ox,
          y: def.parent.y + oy,
          r,
          color: col,
          phase: rng() * Math.PI * 2,
          drift: 0.4 + rng() * 0.9
        });
      }

      // Connect nearby intra-cluster micro-nodes to form gossamer web filaments
      const endIdx = ambientNodes.length;
      for (let i = startIdx; i < endIdx; i++) {
        const a = ambientNodes[i];
        let connections = 0;
        for (let j = i + 1; j < endIdx && connections < 3; j++) {
          const b = ambientNodes[j];
          const d = Math.hypot(a.ox - b.ox, a.oy - b.oy);
          if (d < galaxyR * 0.16 && rng() < 0.62) {
            ambientEdges.push({ a, b, cat: def.cat, kind: 'intra' });
            connections++;
          }
        }
        // Occasional long-range semantic filament across clusters
        if (rng() < 0.12 && startIdx > 0) {
          const other = ambientNodes[Math.floor(rng() * startIdx)];
          ambientEdges.push({ a, b: other, cat: def.cat, kind: 'bridge' });
        }
      }
    });

    // 5. Outer Obsidian Orbital Halo Ring (scattered micro-dots around perimeter)
    const haloCount = isDesktop ? 130 : 72;
    const haloColors = ['#A78BFA', '#F59E0B', '#6EE7B7', '#E2E8F0', '#F472B6', '#7C9CE5'];
    for (let i = 0; i < haloCount; i++) {
      const ang = (i / haloCount) * Math.PI * 2 + (rng() - 0.5) * 0.08;
      const rad = galaxyR * (0.94 + (rng() - 0.5) * 0.12);
      haloDots.push({
        angle: ang,
        rad,
        r: 0.9 + rng() * 1.4,
        color: haloColors[Math.floor(rng() * haloColors.length)],
        speed: (rng() - 0.5) * 0.0004
      });
    }
  }

  function resize() {
    const rect = wrapper.getBoundingClientRect();
    width = rect.width;
    height = rect.height;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.floor(width * dpr));
    canvas.height = Math.max(1, Math.floor(height * dpr));
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    initGraphData();
  }

  let tickTime = 0;

  function stepPhysics() {
    tickTime += 0.014;
    const isDesktop = width > 768;
    const cx = (offsetRight && isDesktop) ? width * 0.59 : width * 0.5;
    const cy = height * 0.5;

    // 1. Repulsion between real interactive nodes
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        let dx = b.x - a.x;
        let dy = b.y - a.y;
        let dist = Math.hypot(dx, dy) || 1;
        const minDist = isDesktop ? 95 : 64;
        if (dist < minDist) {
          const force = ((minDist - dist) / minDist) * 0.28;
          const fx = (dx / dist) * force;
          const fy = (dy / dist) * force;
          if (!a.isRoot && a !== draggedNode) { a.vx -= fx; a.vy -= fy; }
          if (!b.isRoot && b !== draggedNode) { b.vx += fx; b.vy += fy; }
        }
      }
    }

    // 2. Spring links between real nodes
    for (let i = 0; i < links.length; i++) {
      const lk = links[i];
      const dx = lk.target.x - lk.source.x;
      const dy = lk.target.y - lk.source.y;
      const dist = Math.hypot(dx, dy) || 1;
      const force = (dist - lk.length) * lk.strength;
      const fx = (dx / dist) * force;
      const fy = (dy / dist) * force;
      if (!lk.source.isRoot && lk.source !== draggedNode) { lk.source.vx += fx; lk.source.vy += fy; }
      if (!lk.target.isRoot && lk.target !== draggedNode) { lk.target.vx -= fx; lk.target.vy -= fy; }
    }

    // 3. Soft return toward home position + damping
    const padX = isDesktop ? 42 : 24;
    const padY = isDesktop ? 36 : 24;
    for (let i = 0; i < nodes.length; i++) {
      const n = nodes[i];
      if (n === draggedNode) continue;
      if (n.isRoot && n.fx != null) {
        n.x += (n.fx - n.x) * 0.12;
        n.y += (n.fy - n.y) * 0.12;
        continue;
      }
      n.vx += (n.baseX - n.x) * 0.004;
      n.vy += (n.baseY - n.y) * 0.004;
      n.vx *= 0.86;
      n.vy *= 0.86;
      n.x = Math.max(padX, Math.min(width - padX, n.x + n.vx));
      n.y = Math.max(padY, Math.min(height - padY, n.y + n.vy));
    }

    // 4. Ambient micro-nodes smoothly follow parent hub with elastic lag + breathing drift
    for (let i = 0; i < ambientNodes.length; i++) {
      const an = ambientNodes[i];
      const tx = an.parent.x + an.ox + Math.cos(tickTime * an.drift + an.phase) * 2.2;
      const ty = an.parent.y + an.oy + Math.sin(tickTime * an.drift + an.phase) * 2.2;
      an.x += (tx - an.x) * 0.14;
      an.y += (ty - an.y) * 0.14;
    }

    // 5. Gentle halo rotation
    for (let i = 0; i < haloDots.length; i++) {
      haloDots[i].angle += haloDots[i].speed;
    }
  }

  function isNodeInActiveGroup(cat) {
    return activeGroup === 'all' || cat === activeGroup;
  }

  function isNeighbor(nodeA, nodeB) {
    if (!nodeA || !nodeB) return false;
    if (nodeA === nodeB) return true;
    for (let i = 0; i < links.length; i++) {
      if ((links[i].source === nodeA && links[i].target === nodeB) ||
          (links[i].source === nodeB && links[i].target === nodeA)) {
        return true;
      }
    }
    return false;
  }

  function render() {
    stepPhysics();
    ctx.clearRect(0, 0, width, height);

    const pal = getPalette();
    const isObsidian = currentTheme === 'obsidian';
    const isDesktop = width > 768;
    const cx = (offsetRight && isDesktop) ? width * 0.59 : width * 0.5;
    const cy = height * 0.5;

    // 1. Subtle radial nebula depth glow in Obsidian mode
    if (isObsidian) {
      const rad = Math.min(width, height) * 0.52;
      const glow = ctx.createRadialGradient(cx, cy, 10, cx, cy, rad);
      glow.addColorStop(0, 'rgba(234, 122, 28, 0.08)');
      glow.addColorStop(0.55, 'rgba(180, 48, 62, 0.04)');
      glow.addColorStop(1, 'rgba(14, 17, 23, 0)');
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);
    }

    // 2. Outer Obsidian Halo Ring dots
    const haloAlpha = hoveredNode ? 0.25 : 0.72;
    for (let i = 0; i < haloDots.length; i++) {
      const hd = haloDots[i];
      const hx = cx + Math.cos(hd.angle) * hd.rad;
      const hy = cy + Math.sin(hd.angle) * hd.rad;
      ctx.globalAlpha = haloAlpha;
      ctx.fillStyle = isObsidian ? hd.color : 'rgba(26, 29, 52, 0.25)';
      ctx.beginPath();
      ctx.arc(hx, hy, hd.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    // 3. Ambient Gossamer Web Filaments
    ctx.lineWidth = 0.65;
    for (let i = 0; i < ambientEdges.length; i++) {
      const e = ambientEdges[i];
      const inGroup = isNodeInActiveGroup(e.cat);
      const focusMatch = !hoveredNode || hoveredNode.category === e.cat || hoveredNode.isRoot;
      ctx.globalAlpha = (!inGroup ? 0.08 : (focusMatch ? 1 : 0.16));
      ctx.strokeStyle = e.kind === 'bridge' ? pal.edgeBridge : pal.edgeBase;
      ctx.beginPath();
      ctx.moveTo(e.a.x, e.a.y);
      ctx.lineTo(e.b.x, e.b.y);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    // 4. Ambient Semantic Micro-Nodes
    for (let i = 0; i < ambientNodes.length; i++) {
      const an = ambientNodes[i];
      const inGroup = isNodeInActiveGroup(an.cat);
      const focusMatch = !hoveredNode || hoveredNode.category === an.cat || hoveredNode.isRoot;
      ctx.globalAlpha = !inGroup ? 0.1 : (focusMatch ? 0.88 : 0.18);
      ctx.fillStyle = isObsidian ? an.color : getCategoryColor(an.cat);
      ctx.beginPath();
      ctx.arc(an.x, an.y, an.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    // 5. Real Interactive Edges (connecting Lab Root -> Categories -> Live Posts)
    for (let i = 0; i < links.length; i++) {
      const lk = links[i];
      const isHi = hoveredNode && (hoveredNode === lk.source || hoveredNode === lk.target);
      const inGroup = isNodeInActiveGroup(lk.target.category) || isNodeInActiveGroup(lk.source.category);
      ctx.globalAlpha = !inGroup ? 0.12 : (hoveredNode ? (isHi ? 0.95 : 0.15) : 0.55);
      ctx.strokeStyle = isHi ? pal.edgeHighlight : pal.edgeBase;
      ctx.lineWidth = isHi ? 1.4 : 0.9;
      ctx.beginPath();
      ctx.moveTo(lk.source.x, lk.source.y);
      ctx.lineTo(lk.target.x, lk.target.y);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    // 6. Real Interactive Nodes (Root, Categories, Live Posts) + Crisp Labels
    for (let i = 0; i < nodes.length; i++) {
      const n = nodes[i];
      const isHov = hoveredNode === n;
      const isAdj = hoveredNode && isNeighbor(hoveredNode, n);
      const inGroup = n.isRoot || isNodeInActiveGroup(n.category);
      const alpha = !inGroup ? 0.18 : (hoveredNode ? (isHov || isAdj ? 1 : 0.25) : 1);

      const col = n.isRoot ? pal.root : getCategoryColor(n.category);
      const r = isHov ? n.radius + 2.5 : n.radius;

      ctx.globalAlpha = alpha;

      // Soft outer halo on real publication & hub nodes
      if (isObsidian) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, r + (isHov ? 8 : 4.5), 0, Math.PI * 2);
        ctx.fillStyle = col;
        ctx.globalAlpha = alpha * (isHov ? 0.28 : 0.14);
        ctx.fill();
        ctx.globalAlpha = alpha;
      }

      // Solid circular node
      ctx.beginPath();
      ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
      ctx.fillStyle = col;
      ctx.fill();

      // Subtle crisp ring on clickable post nodes
      if (n.type === 'post') {
        ctx.lineWidth = 1.2;
        ctx.strokeStyle = isObsidian ? 'rgba(255,255,255,0.65)' : 'rgba(255,255,255,0.9)';
        ctx.stroke();
      }

      // Labels: always show Root & Categories; show Post labels on desktop or when hovered/active group
      const showLabel = n.isRoot || n.type === 'category' || isHov || isAdj || (isDesktop && n.type === 'post');
      if (showLabel) {
        const fontSize = n.isRoot ? 11 : (n.type === 'category' ? 10 : 9.5);
        const weight = (n.isRoot || n.type === 'category' || isHov) ? '600' : '400';
        ctx.font = `${weight} ${fontSize}px 'IBM Plex Mono', 'JetBrains Mono', monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';

        const text = n.label;
        const tw = ctx.measureText(text).width;
        let lx = n.x;
        let ly = n.y + r + 6;
        // Clamp label inside canvas bounds so nothing clips on mobile or edges
        lx = Math.max(tw / 2 + 10, Math.min(width - tw / 2 - 10, lx));
        ly = Math.min(height - 18, ly);

        // Soft dark pill backing behind text in Obsidian mode for razor readability
        if (isObsidian && (isHov || n.type === 'post' || n.type === 'category' || n.isRoot)) {
          ctx.fillStyle = 'rgba(14, 17, 23, 0.72)';
          ctx.fillRect(lx - tw / 2 - 4, ly - 2, tw + 8, fontSize + 5);
        }

        ctx.fillStyle = isHov ? '#FFFFFF' : (n.type === 'post' ? pal.labelMuted : pal.label);
        if (!isObsidian && isHov) ctx.fillStyle = '#000000';
        ctx.fillText(text, lx, ly);
      }
    }
    ctx.globalAlpha = 1;

    requestAnimationFrame(render);
  }

  function getNodeAt(x, y) {
    // Check interactive nodes from top (posts) to bottom (root)
    for (let i = nodes.length - 1; i >= 0; i--) {
      const n = nodes[i];
      const hitR = Math.max(n.radius + 10, 16);
      if (Math.hypot(x - n.x, y - n.y) <= hitR) {
        return n;
      }
    }
    return null;
  }

  // Drag tracking on window so dragging continues smoothly over buttons / outside canvas
  window.addEventListener('mousemove', (e) => {
    if (!draggedNode) return;
    const rect = canvas.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
    if (Math.abs(e.clientX - downX) + Math.abs(e.clientY - downY) > 4) hasMovedPointer = true;
    if (hasMovedPointer) {
      draggedNode.x = mouseX;
      draggedNode.y = mouseY;
      draggedNode.vx = 0;
      draggedNode.vy = 0;
    }
  });

  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
    if (draggedNode) return;

    const hit = getNodeAt(mouseX, mouseY);
    if (hit !== hoveredNode) {
      hoveredNode = hit;
      canvas.style.cursor = hit ? (hit.url ? 'pointer' : 'grab') : 'default';
      if (hit && (hit.url || hit.desc)) {
        showTooltip(hit, e.clientX, e.clientY);
      } else {
        hideTooltip();
      }
    } else if (hit) {
      positionTooltip(e.clientX, e.clientY);
    }
  });

  canvas.addEventListener('mouseleave', () => {
    if (!draggedNode) {
      hoveredNode = null;
      hideTooltip();
    }
  });

  canvas.addEventListener('mousedown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    isPointerDown = true;
    hasMovedPointer = false;
    downX = e.clientX;
    downY = e.clientY;

    const hit = getNodeAt(x, y);
    if (hit) {
      draggedNode = hit;
      canvas.style.cursor = 'grabbing';
      if (hit.isRoot) hit.fx = null;
    }
  });

  window.addEventListener('mouseup', (e) => {
    if (draggedNode && !hasMovedPointer && draggedNode.url && e.target === canvas) {
      window.location.href = draggedNode.url;
    }
    draggedNode = null;
    isPointerDown = false;
    canvas.style.cursor = hoveredNode ? (hoveredNode.url ? 'pointer' : 'grab') : 'default';
  });

  // Touch support
  canvas.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1) {
      const rect = canvas.getBoundingClientRect();
      const touch = e.touches[0];
      mouseX = touch.clientX - rect.left;
      mouseY = touch.clientY - rect.top;
      const hit = getNodeAt(mouseX, mouseY);
      if (hit) {
        draggedNode = hit;
        hoveredNode = hit;
        hasMovedPointer = false;
        showTooltip(hit, touch.clientX, touch.clientY);
        e.preventDefault();
      }
    }
  }, { passive: false });

  canvas.addEventListener('touchmove', (e) => {
    if (e.touches.length === 1 && draggedNode) {
      const rect = canvas.getBoundingClientRect();
      const touch = e.touches[0];
      draggedNode.x = touch.clientX - rect.left;
      draggedNode.y = touch.clientY - rect.top;
      draggedNode.vx = 0;
      draggedNode.vy = 0;
      hasMovedPointer = true;
      positionTooltip(touch.clientX, touch.clientY);
      e.preventDefault();
    }
  }, { passive: false });

  canvas.addEventListener('touchend', () => {
    if (draggedNode && !hasMovedPointer && draggedNode.url) {
      window.location.href = draggedNode.url;
    }
    draggedNode = null;
  });

  // Tooltip helpers
  function showTooltip(node, clientX, clientY) {
    if (!tooltip) return;
    ttKicker.textContent = node.type === 'post'
      ? `DOSSIER // ${node.category.toUpperCase()}`
      : (node.type === 'category' ? 'CLUSTER HUB' : 'LAB CORE');
    ttTitle.textContent = node.fullTitle || node.label;
    ttDesc.textContent = node.desc || 'Explore connecting nodes in this research cluster.';
    ttAction.style.display = node.url ? 'block' : 'none';
    tooltip.style.display = 'block';
    positionTooltip(clientX, clientY);
  }

  function positionTooltip(clientX, clientY) {
    if (!tooltip) return;
    const pad = 16;
    let x = clientX + pad;
    let y = clientY + pad;
    if (x + 280 > window.innerWidth) x = Math.max(12, clientX - 290);
    if (y + 160 > window.innerHeight) y = Math.max(12, clientY - 170);
    tooltip.style.left = x + 'px';
    tooltip.style.top = y + 'px';
  }

  function hideTooltip() {
    if (tooltip) tooltip.style.display = 'none';
  }

  // Group Filter Chips
  groupChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeGroup = chip.getAttribute('data-group') || 'all';
      groupChips.forEach((c) => c.classList.toggle('active', c === chip));
    });
  });

  // Theme Toggle (Obsidian <-> Paper)
  if (btnTheme) {
    btnTheme.addEventListener('click', () => {
      currentTheme = currentTheme === 'obsidian' ? 'paper' : 'obsidian';
      wrapper.className = `kg-container theme-${currentTheme}`;
      hoveredNode = null;
      hideTooltip();
    });
  }

  // Recenter Graph
  if (btnCenter) {
    btnCenter.addEventListener('click', () => {
      hoveredNode = null;
      hideTooltip();
      initGraphData();
    });
  }

  window.addEventListener('resize', resize);
  resize();
  render();
})();
</script>

