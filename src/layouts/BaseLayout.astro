---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  showProgress?: boolean;
}

const {
  title = "AI Architecture Lab",
  description = "Digital laboratory exploring the intersection of architecture, artificial intelligence, and computational workflows.",
  fullWidth = false,
  showProgress = false,
} = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/work", label: "Tools" },
  { href: "/resources", label: "Workflows" },
  { href: "/experiments", label: "Experiments" },
  { href: "/about", label: "About" }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title === "AI Architecture Lab" ? title : `${title} — AI Architecture Lab`}</title>
    <meta name="description" content={description} />

    <!-- Unified Genesis.ai Typography: Inter (400/500) + IBM Plex Mono (400/500) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="genesis-unified">
    {showProgress && <div id="prog"></div>}

    <div class="g-shell">
      <!-- TOP ANNOUNCEMENT BAR (Identical to Home) -->
      <div class="g-announce-wrap">
        <a href="/experiments/where-ai-actually-works-in-aec" class="g-announce-bar">
          <span class="g-announce-dot"></span>
          <span>New Benchmark EXP_004: Where AI Actually Works in AEC &mdash; Read full dossier</span>
        </a>
      </div>

      <!-- MINIMAL GENESIS HEADER (Identical to Home) -->
      <header class="site-header g-header">
        <div class="g-header-inner">
          <a href="/" class="g-brand">
            <span class="g-logo-ring" aria-hidden="true"></span>
            <span>AI Architecture Lab</span>
          </a>

          <div class="nav-panel" id="nav-panel">
            <nav class="site-nav" aria-label="Navegación principal">
              {navItems.map((item) => {
                const isActive = currentPath.startsWith(item.href);
                return (
                  <a
                    href={item.href}
                    class={`nav-link hover-ul ${isActive ? 'active' : ''}`}
                  >
                    {item.label}
                  </a>
                );
              })}
              <a href="/#knowledge-graph" class="nav-link hover-ul g-nav-mobile-only">Knowledge Graph</a>
              <a href="/editorial" class="nav-link hover-ul g-nav-mobile-only">Versión Editorial</a>
            </nav>
          </div>

          <div class="g-nav-right">
            <a href="/#knowledge-graph" class="hover-ul">Graph</a>
            <a href="/editorial" class="hover-ul">Editorial</a>
            <LanguageSwitcher />
          </div>

          <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-panel">
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </button>
        </div>
      </header>

      <main class={fullWidth ? "main-full" : "container main-constrained"}>
        <slot />
      </main>

      <!-- DEEP NAVY FOOTER CARD (Identical to Home) -->
      <div class="g-footer-band">
        <footer class="g-footer">
          <div class="g-footer-ticks" aria-hidden="true">
            <span class="g-tick"></span><span class="g-tick"></span><span class="g-tick"></span>
          </div>

          <div class="g-footer-grid">
            <div>
              <a href="/" class="g-footer-brand">
                <span class="g-logo-ring" aria-hidden="true"></span>
                <span>AI Architecture Lab</span>
              </a>
            </div>

            <div>
              <span class="g-tick" aria-hidden="true"></span>
              <p class="g-footer-tagline">Less repetition.<br />More exploration.</p>
            </div>

            <div class="g-footer-col">
              <span class="g-tick" aria-hidden="true" style="margin-bottom: 6px;"></span>
              <a href="/work" class="g-footer-link">Tools</a>
              <a href="/resources" class="g-footer-link">Workflows</a>
              <a href="/experiments" class="g-footer-link">Experiments</a>
              <a href="/about" class="g-footer-link">About</a>
            </div>

            <div class="g-footer-col">
              <span class="g-tick" aria-hidden="true" style="margin-bottom: 6px;"></span>
              <a href="/#knowledge-graph" class="g-footer-link">Knowledge Graph</a>
              <a href="/editorial" class="g-footer-link">Editorial Edition</a>
              <a href="/Google_Stitch/" class="g-footer-link">Design Archive</a>
            </div>
          </div>

          <div class="g-footer-bottom">
            <span>&copy; {new Date().getFullYear()} Architecture AI Lab &mdash; Jorge Lude&ntilde;a</span>
            <span>Astro Static &middot; Open Research</span>
          </div>
        </footer>
      </div>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('nav-toggle');
        var panel = document.getElementById('nav-panel');
        if (!btn || !panel) return;
        function setOpen(open) {
          panel.classList.toggle('open', open);
          btn.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        }
        btn.addEventListener('click', function () { setOpen(!panel.classList.contains('open')); });
        panel.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
        window.addEventListener('resize', function () { if (window.innerWidth > 768) setOpen(false); });
      })();
    </script>

    {showProgress && (
      <script is:inline>
        const b = document.getElementById('prog');
        if (b) {
          window.addEventListener('scroll', () => {
            const m = document.body.scrollHeight - window.innerHeight;
            if (m > 0) {
              b.style.width = (window.scrollY / m * 100) + '%';
            }
          }, { passive: true });
        }
      </script>
    )}
  </body>
</html>
